---
import "../styles/globals.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "akbarweb.com — Jasa Pembuatan Website Profesional & Cepat",
  description = "Jasa pembuatan website profesional di Indonesia. Landing page, company profile, e-commerce, dan web app. Cepat, SEO-friendly, dan fokus konversi. Konsultasi gratis via WhatsApp.",
} = Astro.props;

const navLinks = [
  { href: "#layanan", label: "Layanan" },
  { href: "#harga", label: "Harga" },
  { href: "#kontak", label: "Kontak" },
];

const tahun = new Date().getFullYear();
const waNumber = "6285938573419";
const waDefault = `https://wa.me/${waNumber}?text=${encodeURIComponent("Halo akbarweb, saya ingin konsultasi pembuatan website.")}`;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Slot Head untuk Canonical, Keywords, & Schema Markup dari Halaman Child -->
    <slot name="head" />

    <!-- Mobile & Android Native Theme Config -->
    <meta name="theme-color" content="#003580" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- OG Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="akbarweb.com" />
    <meta property="og:image" content="https://images.unsplash.com/photo-1460925895917-afdab827c52f?q=80&w=1200&auto=format&fit=crop" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23003580' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Crect width='24' height='24' rx='4' fill='white'/%3E%3Ccircle cx='12' cy='12' r='8'/%3E%3Cline x1='12' y1='4' x2='12' y2='20'/%3E%3Cpath d='M4.93 9h14.14'/%3E%3Cpath d='M4.93 15h14.14'/%3E%3C/svg%3E" />

    <style>
      /* Utility touch android feel */
      * {
        -webkit-tap-highlight-color: transparent;
      }
    </style>
  </head>

  <body class="bg-white text-gray-800 antialiased flex flex-col min-h-screen pb-20 md:pb-0">

    <!-- ================= HEADER (App Bar Style) ================= -->
    <header class="sticky top-0 z-40 bg-booking-700 text-white shadow-md">
      <nav class="max-w-5xl mx-auto px-4 h-14 sm:h-16 flex items-center justify-between gap-3">

        <!-- Logo Kiri -->
        <a href="/web" class="group flex items-center gap-2 shrink-0">
          <span class="w-8 h-8 grid place-items-center rounded-lg bg-white text-booking-700 shadow-sm transition-transform duration-200 active:scale-95">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
              <circle cx="12" cy="12" r="9"/>
              <line x1="12" y1="3" x2="12" y2="21"/>
              <path d="M3.6 9h16.8"/>
              <path d="M3.6 15h16.8"/>
            </svg>
          </span>
          <span class="font-bold text-base sm:text-lg tracking-tight text-white">
            Akbar<span class="text-yellow-400">Web</span>
          </span>
        </a>

        <!-- Desktop Menu -->
        <ul class="hidden md:flex items-center justify-center gap-6 lg:gap-8 text-sm font-medium text-white/90 flex-1">
          {navLinks.map((l) => (
            <li>
              <a href={l.href} class="py-1 hover:text-yellow-400 transition-colors duration-200">
                {l.label}
              </a>
            </li>
          ))}
        </ul>

        <!-- Tombol CTA -->
        <a href={waDefault} target="_blank" rel="noopener noreferrer"
           class="bk-btn-yellow px-3 sm:px-4 py-1.5 sm:py-2 text-xs sm:text-sm shrink-0 shadow-md">
          Konsultasi Gratis
        </a>
      </nav>
    </header>

    <!-- Main Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- ================= FOOTER ================= -->
    <footer class="bg-booking-700 text-white/90">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 sm:py-12 grid gap-8 md:grid-cols-4">
        <div class="md:col-span-2">
          <a href="/web" class="flex items-center gap-2.5 mb-4 group w-fit">
            <span class="w-8 h-8 grid place-items-center rounded-lg bg-white text-booking-700 shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
                <circle cx="12" cy="12" r="9"/>
                <line x1="12" y1="3" x2="12" y2="21"/>
                <path d="M3.6 9h16.8"/>
                <path d="M3.6 15h16.8"/>
              </svg>
            </span>
            <span class="font-bold text-lg text-white">
              akbarweb<span class="text-yellow-400">.com</span>
            </span>
          </a>
          <p class="text-xs sm:text-sm leading-relaxed max-w-sm text-white/80">
            Membantu bisnis Anda tampil profesional di internet dengan website cepat, modern, dan siap konversi.
          </p>

          <div class="flex gap-3 mt-5">
            <a href="#" aria-label="Instagram" class="w-9 h-9 grid place-items-center rounded-lg bg-booking-800 text-white active:bg-yellow-500 active:text-booking-700 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
            </a>
            <a href={waDefault} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="w-9 h-9 grid place-items-center rounded-lg bg-booking-800 text-white active:bg-yellow-500 active:text-booking-700 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.5 14.2c-.2.6-1.2 1.1-1.7 1.2-.4.1-1 .1-1.6-.1-.4-.1-.9-.3-1.6-.6-2.8-1.2-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.8s.7-2 .9-2.2c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.4l.8 2c.1.2.1.3 0 .5l-.4.5c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.2.1.4.1.5-.1l.6-.7c.2-.2.3-.2.6-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.2Z"/></svg>
            </a>
          </div>
        </div>

        <div>
          <h4 class="text-white font-bold mb-3 text-xs uppercase tracking-wide">Layanan</h4>
          <ul class="space-y-2 text-xs sm:text-sm text-white/80">
            {["Landing Page", "Company Profile", "Toko Online", "Maintenance"].map((item) => (
              <li>
                <a href="#layanan" class="hover:text-yellow-400 transition-colors">
                  {item}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h4 class="text-white font-bold mb-3 text-xs uppercase tracking-wide">Kontak</h4>
          <ul class="space-y-2 text-xs sm:text-sm text-white/80">
            <li class="flex items-center gap-2">📧 halo@akbarweb.com</li>
            <li class="flex items-center gap-2">📱 +62 859-3857-3419</li>
            <li class="flex items-center gap-2">📍 Indonesia</li>
          </ul>
        </div>
      </div>

      <div class="border-t border-white/10 bg-booking-800/50">
        <p class="max-w-5xl mx-auto px-4 sm:px-6 py-4 text-[11px] text-white/60 flex flex-col sm:flex-row justify-between items-center gap-2 text-center">
          <span>© {tahun} <span class="text-yellow-400 font-semibold">akbarweb.com</span>. All rights reserved.</span>
          <span class="font-mono text-[10px]">PWA Ready · Astro + Tailwind</span>
        </p>
      </div>
    </footer>

    <!-- ================= ANDROID BOTTOM NAVIGATION BAR (Modern Floating Glass Dock) ================= -->
    <div class="md:hidden fixed bottom-3 left-4 right-4 z-50 bg-booking-700/95 backdrop-blur-md border border-yellow-500/30 rounded-2xl shadow-[0_8px_32px_rgba(0,53,128,0.4)] px-3 py-2">
      <div class="flex items-center justify-between">
        
        <!-- Home Item -->
        <a href="#" class="flex flex-col items-center justify-center flex-1 py-1 text-yellow-400 active:scale-90 transition-transform">
          <div class="w-10 h-7 rounded-full bg-yellow-500/20 flex items-center justify-center mb-0.5 border border-yellow-500/40">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 stroke-[2.2]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
          </div>
          <span class="text-[10px] font-bold tracking-tight">Home</span>
        </a>

        <!-- Layanan Item -->
        <a href="#layanan" class="flex flex-col items-center justify-center flex-1 py-1 text-white/70 hover:text-yellow-400 active:scale-90 transition-transform">
          <div class="w-10 h-7 rounded-full flex items-center justify-center mb-0.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 stroke-[2.2]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/>
              <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/>
            </svg>
          </div>
          <span class="text-[10px] font-medium tracking-tight">Layanan</span>
        </a>

        <!-- Harga Item -->
        <a href="#harga" class="flex flex-col items-center justify-center flex-1 py-1 text-white/70 hover:text-yellow-400 active:scale-90 transition-transform">
          <div class="w-10 h-7 rounded-full flex items-center justify-center mb-0.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 stroke-[2.2]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
            </svg>
          </div>
          <span class="text-[10px] font-medium tracking-tight">Harga</span>
        </a>

        <!-- Chat WA Item -->
        <a href={waDefault} target="_blank" rel="noopener noreferrer" class="flex flex-col items-center justify-center flex-1 py-1 text-emerald-400 active:scale-90 transition-transform">
          <div class="w-10 h-7 rounded-full bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center mb-0.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 fill-emerald-400" viewBox="0 0 24 24">
              <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.5 14.2c-.2.6-1.2 1.1-1.7 1.2-.4.1-1 .1-1.6-.1-.4-.1-.9-.3-1.6-.6-2.8-1.2-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.8s.7-2 .9-2.2c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.4l.8 2c.1.2.1.3 0 .5l-.4.5c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.2.1.4.1.5-.1l.6-.7c.2-.2.3-.2.6-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.2Z"/>
            </svg>
          </div>
          <span class="text-[10px] font-bold tracking-tight">Chat WA</span>
        </a>

      </div>
    </div>

  </body>
</html>