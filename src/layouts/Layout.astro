---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = "CV Green Fresh Cipanas",
  description = "Penyedia produk pertanian, sayuran, jamur, dan bahan pangan segar berkualitas tinggi dari petani lokal Cipanas & Puncak.",
  canonical
} = Astro.props;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content="Green Fresh" />
		<meta name="theme-color" content="#022c22" />

		<title>{title}</title>
		<meta name="description" content={description} />

		<!-- Render Tag Canonical jika dipassing via props -->
		{canonical && <link rel="canonical" href={canonical} />}

		<!-- 
		  SLOT HEAD UNTUK MENANGKAP META, JSON-LD SCHEMA, & CANONICAL 
		  DARI FILE [id].astro DAN HALAMAN LAINNYA 
		-->
		<slot name="head" />
		<slot name="head-meta" />

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
	</head>
	<body class="bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col selection:bg-emerald-500 selection:text-white">

		<!-- Sticky Header dengan Animasi Transisi -->
		<header 
			id="main-header"
			class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-emerald-100/80 shadow-sm transition-all duration-300 ease-in-out"
		>
			<div 
				id="header-container"
				class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 md:h-24 flex items-center justify-between gap-3 transition-all duration-300 ease-in-out"
			>
				<a href="/" class="flex items-center shrink-0 py-1">
					<img 
						id="header-logo"
						src="/logo.png" 
						alt="CV Green Fresh Cipanas" 
						class="h-10 sm:h-14 md:h-18 w-auto object-contain transition-all duration-300 ease-in-out hover:scale-105"
					/>
				</a>

				<nav class="hidden md:flex items-center gap-8 font-medium text-slate-600 text-sm">
					<a href="/#hero" class="hover:text-emerald-600 transition-colors duration-200">Beranda</a>
					<a href="/#tentang-kami" class="hover:text-emerald-600 transition-colors duration-200">Tentang Kami</a>
					<a href="/#katalog" class="hover:text-emerald-600 transition-colors duration-200">Katalog Produk</a>
					<a href="/#informasi-perusahaan" class="hover:text-emerald-600 transition-colors duration-200">Kontak & Rekening</a>
					<a href="/#faq" class="hover:text-emerald-600 transition-colors duration-200">FAQ</a>
				</nav>

				<a 
					href="/#order-form" 
					class="shrink-0 px-3.5 py-2 sm:px-5 sm:py-2.5 rounded-full bg-emerald-600 text-white font-semibold hover:bg-emerald-700 active:scale-95 transition-all duration-200 shadow-md shadow-emerald-600/20 text-xs sm:text-sm whitespace-nowrap"
				>
					Pesan B2B
				</a>
			</div>
		</header>

		<!-- Main Content Slot (diisolasi agar tidak bocor ke samping) -->
		<main class="flex-grow w-full overflow-x-clip">
			<slot />
		</main>

	<!-- Footer -->
<footer class="bg-slate-900 text-slate-400 py-12 border-t border-slate-800 text-sm w-full overflow-x-clip">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Baris atas: brand + navigasi -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-10 border-b border-slate-800">
      
      <!-- Brand -->
      <div class="md:col-span-5 flex items-start gap-3">
        <img
          src="/logo.png"
          alt="CV Green Fresh Cipanas"
          class="h-10 sm:h-12 w-auto object-contain brightness-200 shrink-0"
        />
        <div>
          <p class="font-bold text-white text-base">CV Green Fresh Cipanas</p>
          <p class="mt-1 text-xs text-slate-400 leading-relaxed">
            Pemasok Sayuran & Hasil Tani Segar Terpercaya untuk hotel, restoran, katering, dan supermarket.
          </p>
        </div>
      </div>

      <!-- Navigasi -->
      <nav class="md:col-span-4" aria-label="Footer navigation">
        <h3 class="text-white font-extrabold text-xs uppercase tracking-widest mb-4">Navigasi</h3>
        <ul class="grid grid-cols-2 gap-y-2.5 gap-x-6 text-xs">
          <li>
            <a href="/" class="inline-flex items-center gap-1.5 hover:text-emerald-400 transition-colors">
              <span class="w-1 h-1 rounded-full bg-emerald-500"></span> Beranda
            </a>
          </li>
          <li>
            <a href="/about" class="inline-flex items-center gap-1.5 hover:text-emerald-400 transition-colors">
              <span class="w-1 h-1 rounded-full bg-emerald-500"></span> Tentang Kami
            </a>
          </li>
          <li>
            <a href="/blog" class="inline-flex items-center gap-1.5 hover:text-emerald-400 transition-colors">
              <span class="w-1 h-1 rounded-full bg-emerald-500"></span> Blog
            </a>
          </li>
          <li>
            <a href="/#katalog" class="inline-flex items-center gap-1.5 hover:text-emerald-400 transition-colors">
              <span class="w-1 h-1 rounded-full bg-emerald-500"></span> Katalog
            </a>
          </li>
          <li>
            <a href="/#faq" class="inline-flex items-center gap-1.5 hover:text-emerald-400 transition-colors">
              <span class="w-1 h-1 rounded-full bg-emerald-500"></span> FAQ
            </a>
          </li>
          <li>
            <a href="/layanan" class="inline-flex items-center gap-1.5 hover:text-emerald-400 transition-colors">
              <span class="w-1 h-1 rounded-full bg-emerald-500"></span> Area Layanan
            </a>
          </li>
        </ul>
      </nav>

      <!-- Kontak -->
      <div class="md:col-span-3">
        <h3 class="text-white font-extrabold text-xs uppercase tracking-widest mb-4">Kontak</h3>
        <ul class="space-y-2.5 text-xs">
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span class="leading-relaxed">Kp. Kayumanis, Pacet, Cianjur, Jawa Barat</span>
          </li>
          <li>
            <a href="https://wa.me/6287780937884" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 hover:text-emerald-400 transition-colors">
              <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              0877-8093-7884
            </a>
          </li>
          <li>
            <a href="mailto:cs@greenfresh.co.id" class="inline-flex items-center gap-2 hover:text-emerald-400 transition-colors">
              <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              cs@greenfresh.co.id
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Baris bawah: copyright -->
    <div class="pt-6 flex flex-col sm:flex-row justify-between items-center gap-3">
      <p class="text-xs text-slate-500 text-center sm:text-left">
        © {new Date().getFullYear()} CV Green Fresh Cipanas. All rights reserved.
      </p>
      <p class="text-[11px] text-slate-600 text-center sm:text-right">
        Supplier Sayur B2B · Grade A · Termin 7 Hari
      </p>
    </div>
  </div>
</footer>

		<!-- Script Animasi Scroll Header -->
		<script>
			const header = document.getElementById('main-header');
			const container = document.getElementById('header-container');
			const logo = document.getElementById('header-logo');

			window.addEventListener('scroll', () => {
				if (window.scrollY > 20) {
					header?.classList.add('shadow-md', 'bg-white/98');
					header?.classList.remove('bg-white/90', 'shadow-sm');

					container?.classList.add('h-13', 'sm:h-16', 'md:h-18');
					container?.classList.remove('h-16', 'sm:h-20', 'md:h-24');

					logo?.classList.add('h-8', 'sm:h-11', 'md:h-14');
					logo?.classList.remove('h-10', 'sm:h-14', 'md:h-18');
				} else {
					header?.classList.add('shadow-sm', 'bg-white/90');
					header?.classList.remove('shadow-md', 'bg-white/98');

					container?.classList.add('h-16', 'sm:h-20', 'md:h-24');
					container?.classList.remove('h-13', 'sm:h-16', 'md:h-18');

					logo?.classList.add('h-10', 'sm:h-14', 'md:h-18');
					logo?.classList.remove('h-8', 'sm:h-11', 'md:h-14');
				}
			});
		</script>

	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		font-family: 'Plus Jakarta Sans', sans-serif;
	}

	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.animate-fade-in-up {
		animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
	}
</style>