---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = "CV Green Fresh Cipanas",
  description = "Penyedia produk pertanian, sayuran, jamur, dan bahan pangan segar berkualitas tinggi dari petani lokal Cipanas & Puncak.",
  canonical
} = Astro.props;

const navLinks = [
  { href: '/#hero', label: 'Beranda' },
  { href: '/#katalog', label: 'Katalog Produk' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'Tentang Kami' },
  { href: '/layanan', label: 'Layanan' },
  { href: '/#faq', label: 'FAQ' },
];
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Green Fresh" />
    <meta name="theme-color" content="#064e3b" />

    <title>{title}</title>
    <meta name="description" content={description} />

    {canonical && <link rel="canonical" href={canonical} />}

    <slot name="head" />
    <slot name="head-meta" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col selection:bg-emerald-500 selection:text-white">

    <!-- ===================== STICKY HEADER (WARNA HIDUP) ===================== -->
    <header
      id="main-header"
      class="sticky top-0 z-50 transition-all duration-300 ease-in-out border-b-[3px] border-emerald-400/60 shadow-lg shadow-emerald-900/20 header-gradient"
    >
      <div
        id="header-container"
        class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 flex items-center justify-between gap-2 sm:gap-3 transition-all duration-300 ease-in-out h-20 md:h-24"
      >
        <!-- LOGO dalam badge putih -->
        <a href="/" class="flex items-center shrink-0 group">
          <div class="bg-white rounded-2xl px-2.5 py-1.5 shadow-md shadow-emerald-950/40 ring-1 ring-emerald-300/40 group-hover:ring-emerald-300/80 group-hover:scale-105 transition-all duration-300">
            <img
              id="header-logo"
              src="/logo.png"
              alt="CV Green Fresh Cipanas"
              class="w-auto object-contain transition-all duration-300 ease-in-out"
              style="height: var(--logo-size, 48px);"
            />
          </div>
        </a>

        <!-- NAV DESKTOP -->
        <nav class="hidden md:flex items-center gap-1 lg:gap-1.5 font-semibold text-emerald-50 text-sm">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class="px-3 lg:px-3.5 py-2 rounded-full bg-white/0 hover:bg-white/15 border border-transparent hover:border-white/30 text-emerald-50 hover:text-white transition-all duration-200 backdrop-blur-sm"
            >
              {link.label}
            </a>
          ))}
        </nav>

        <!-- AKSI KANAN -->
        <div class="flex items-center gap-2 sm:gap-3 shrink-0">
          <a
            href="/#order-form"
            class="hidden sm:inline-flex items-center gap-1.5 px-4 py-2 md:px-5 md:py-2.5 rounded-full bg-gradient-to-r from-amber-400 to-yellow-300 text-emerald-950 font-extrabold hover:from-amber-300 hover:to-yellow-200 active:scale-95 transition-all duration-200 shadow-lg shadow-amber-500/40 ring-2 ring-white/30 text-xs md:text-sm whitespace-nowrap"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            Pesan B2B
          </a>

          <!-- Hamburger (putih glass) -->
          <button
            id="mobile-menu-toggle"
            type="button"
            aria-label="Buka menu navigasi"
            aria-expanded="false"
            aria-controls="mobile-menu"
            class="md:hidden inline-flex items-center justify-center w-11 h-11 rounded-xl bg-white/15 text-white border border-white/40 backdrop-blur-md active:scale-95 hover:bg-white/25 transition-all"
          >
            <svg id="icon-open" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- MOBILE MENU DRAWER (warna selaras) -->
      <div
        id="mobile-menu"
        class="md:hidden hidden border-t border-white/20 drawer-gradient shadow-2xl max-h-[calc(100vh-80px)] overflow-y-auto"
      >
        <nav class="px-3 py-3 flex flex-col text-emerald-50 text-sm font-semibold">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class="px-3 py-3 rounded-xl hover:bg-white/15 hover:text-white border border-transparent hover:border-white/20 transition-all"
            >
              {link.label}
            </a>
          ))}
          <a
            href="/#order-form"
            class="mt-2 px-4 py-3 rounded-xl bg-gradient-to-r from-amber-400 to-yellow-300 text-emerald-950 text-center font-extrabold hover:from-amber-300 hover:to-yellow-200 active:scale-95 transition-all shadow-lg shadow-amber-500/40 ring-2 ring-white/30"
          >
            Pesan B2B Sekarang
          </a>
        </nav>
      </div>
    </header>

    <!-- ===================== MAIN ===================== -->
    <main class="flex-grow w-full overflow-x-clip">
      <slot />
    </main>

    <!-- ===================== FOOTER ===================== -->
    <footer class="bg-slate-900 text-slate-400 py-12 border-t border-slate-800 text-sm w-full overflow-x-clip">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-10 border-b border-slate-800">

          <!-- Brand -->
          <div class="md:col-span-5 flex items-start gap-3">
            <img
              src="/logo.png"
              alt="CV Green Fresh Cipanas"
              class="h-10 sm:h-12 w-auto object-contain brightness-200 shrink-0"
            />
            <div>
              <p class="font-bold text-white text-base">CV Green Fresh Cipanas</p>
              <p class="mt-1 text-xs text-slate-400 leading-relaxed">
                Pemasok Sayuran & Hasil Tani Segar Terpercaya untuk hotel, restoran, katering, dan supermarket.
              </p>
            </div>
          </div>

          <!-- Navigasi -->
          <nav class="md:col-span-4" aria-label="Footer navigation">
            <h3 class="text-white font-extrabold text-xs uppercase tracking-widest mb-4">Navigasi</h3>
            <ul class="grid grid-cols-2 gap-y-2.5 gap-x-6 text-xs">
              {navLinks.map((link) => (
                <li>
                  <a href={link.href} class="inline-flex items-center gap-1.5 hover:text-emerald-400 transition-colors">
                    <span class="w-1 h-1 rounded-full bg-emerald-500"></span> {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>

          <!-- Kontak -->
          <div class="md:col-span-3">
            <h3 class="text-white font-extrabold text-xs uppercase tracking-widest mb-4">Kontak</h3>
            <ul class="space-y-2.5 text-xs">
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 mt-0.5 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                <span class="leading-relaxed">Kp. Kayumanis, Pacet, Cianjur, Jawa Barat</span>
              </li>
              <li>
                <a href="https://wa.me/6287780937884" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 hover:text-emerald-400 transition-colors">
                  <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                  </svg>
                  0877-8093-7884
                </a>
              </li>
              <li>
                <a href="mailto:cs@greenfresh.co.id" class="inline-flex items-center gap-2 hover:text-emerald-400 transition-colors">
                  <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                  cs@greenfresh.co.id
                </a>
              </li>
            </ul>
          </div>
        </div>

        <div class="pt-6 flex flex-col sm:flex-row justify-between items-center gap-3">
          <p class="text-xs text-slate-500 text-center sm:text-left">
            © {new Date().getFullYear()} CV Green Fresh Cipanas. All rights reserved.
          </p>
          <p class="text-[11px] text-slate-600 text-center sm:text-right">
            Supplier Sayur B2B · Grade A · Termin 7 Hari
          </p>
        </div>
      </div>
    </footer>

    <!-- ===================== SCRIPTS ===================== -->
    <script>
      // ---------- 1. Mobile Menu Toggle ----------
      const toggle = document.getElementById('mobile-menu-toggle');
      const menu = document.getElementById('mobile-menu');
      const iconOpen = document.getElementById('icon-open');
      const iconClose = document.getElementById('icon-close');

      const setMenuState = (isOpen: boolean) => {
        if (!menu || !toggle) return;
        menu.classList.toggle('hidden', !isOpen);
        iconOpen?.classList.toggle('hidden', isOpen);
        iconClose?.classList.toggle('hidden', !isOpen);
        toggle.setAttribute('aria-expanded', String(isOpen));
        toggle.setAttribute('aria-label', isOpen ? 'Tutup menu navigasi' : 'Buka menu navigasi');
      };

      toggle?.addEventListener('click', () => {
        const isOpen = !menu?.classList.contains('hidden');
        setMenuState(!isOpen);
      });

      menu?.querySelectorAll('a').forEach((a) => {
        a.addEventListener('click', () => setMenuState(false));
      });

      window.addEventListener('resize', () => {
        if (window.innerWidth >= 768) setMenuState(false);
      });

      // ---------- 2. Scroll Shrink ----------
      const header = document.getElementById('main-header');
      const container = document.getElementById('header-container');

      const onScroll = () => {
        const scrolled = window.scrollY > 20;

        document.documentElement.style.setProperty(
          '--logo-size',
          scrolled ? (window.innerWidth >= 768 ? '40px' : '36px') : (window.innerWidth >= 768 ? '52px' : '44px')
        );

        if (container) {
          container.style.height = scrolled
            ? (window.innerWidth >= 768 ? '72px' : '64px')
            : (window.innerWidth >= 768 ? '96px' : '80px');
        }

        header?.classList.toggle('header-scrolled', scrolled);
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      onScroll();
    </script>

  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
    font-family: 'Plus Jakarta Sans', sans-serif;
  }

  /* ====== HEADER GRADIENT (normal) ====== */
  .header-gradient {
    background: linear-gradient(135deg, #065f46 0%, #047857 45%, #0d9488 100%);
  }

  /* ====== HEADER SAAT SCROLL (lebih pekat + glow) ====== */
  .header-gradient.header-scrolled {
    background: linear-gradient(135deg, #022c22 0%, #064e3b 45%, #0f766e 100%);
    box-shadow: 0 8px 28px -4px rgba(4, 120, 87, 0.55), 0 2px 8px rgba(0, 0, 0, 0.25);
  }

  /* ====== DRAWER MOBILE ====== */
  .drawer-gradient {
    background: linear-gradient(180deg, #064e3b 0%, #065f46 100%);
  }

  /* ====== LOGO ====== */
  #header-logo {
    height: var(--logo-size, 44px);
    transition: height 0.3s ease-in-out;
  }

  @media (min-width: 768px) {
    #header-logo {
      height: var(--logo-size, 52px);
    }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    #header-logo,
    .header-gradient {
      transition: none;
    }
  }
</style>