---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical: string;
  category?: string;
  date?: string;
  readTime?: string;
  author?: string;
}

const {
  title,
  description,
  image = "https://sewavillapuncak.id/og-default.jpg",
  canonical,
  category,
  date,
  readTime,
  author,
} = Astro.props;

const isArticle = !!category && !!date;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <!-- ═══ PRIMARY SEO ═══ -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />

    <!-- ═══ LANGUAGE & GEO ═══ -->
    <meta name="language" content="Indonesian" />
    <meta name="geo.region" content="ID-JB" />
    <meta name="geo.placename" content="Cipanas, Cianjur" />
    <meta name="geo.position" content="-6.7571;107.0376" />
    <meta name="ICBM" content="-6.7571, 107.0376" />

    <!-- ═══ OPEN GRAPH ═══ -->
    <meta property="og:type" content={isArticle ? "article" : "website"} />
    <meta property="og:site_name" content="Green Fresh Cipanas" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="id_ID" />

    {isArticle && (
      <>
        <meta property="article:published_time" content={date} />
        <meta property="article:section" content={category} />
        <meta property="article:author" content={author || "Green Fresh Cipanas"} />
      </>
    )}

    <!-- ═══ TWITTER ═══ -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- ═══ PERFORMANCE ═══ -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.google.com" />

    <!-- ═══ THEME & ICON ═══ -->
    <meta name="theme-color" content="#2563eb" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- ═══ HREFLANG ═══ -->
    <link rel="alternate" hreflang="id" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <!-- ═══ FONTS ═══ -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Space+Grotesk:wght@500;600;700&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap" rel="stylesheet" />

    <slot name="head-extra" />
  </head>
  <body>
    {isArticle && (
      <div
        id="reading-progress"
        class="fixed top-0 left-0 h-[3px] z-[60] bg-gradient-to-r from-[var(--c-cyan)] to-[var(--c-electric)] transition-[width] duration-100"
        style="width: 0%"
        aria-hidden="true"
      ></div>
    )}

    <slot />

    {isArticle && (
      <script>
        (() => {
          const bar = document.getElementById("reading-progress");
          if (!bar) return;
          const updateProgress = () => {
            const scrollTop = window.scrollY;
            const docHeight = document.documentElement.scrollHeight - window.innerHeight;
            const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
            bar.style.width = `${Math.min(progress, 100)}%`;
          };
          window.addEventListener("scroll", updateProgress, { passive: true });
          updateProgress();
        })();
      </script>
    )}
  </body>
</html>

<!-- ═══════════════════════════════════════════════════════
     BLOG THEME · LIGHT BLUE · Reading-optimized
     ═══════════════════════════════════════════════════════ -->
<style is:global>
  :root {
    /* ── Surfaces — terang & biru ── */
    --c-bg:        #f5f9ff;
    --c-bg-alt:    #eaf2ff;
    --c-surface:   #ffffff;
    --c-surface-2: #eef4ff;
    --c-glass:     rgba(255, 255, 255, 0.75);

    /* ── Lines — biru muda ── */
    --c-line:      #d6e4f7;
    --c-line-soft: rgba(59, 130, 246, 0.12);

    /* ── Text — navy gelap ── */
    --c-ink:        #1e293b;
    --c-ink-strong: #0f1d3d;
    --c-muted:      #64748b;
    --c-faint:      #94a3b8;

    /* ── Accents — biru & cyan ── */
    --c-electric:  #2563eb;
    --c-cyan:      #0891b2;
    --c-violet:    #7c3aed;
    --c-blue-400:  #3b82f6;
    --c-blue-300:  #60a5fa;

    --c-wa:        #22c55e;
    --c-wa-ink:    #ffffff;

    /* ── Radii ── */
    --r-xs: 10px;
    --r-sm: 14px;
    --r-md: 20px;
    --r-lg: 28px;
    --r-xl: 36px;

    /* ── Shadows ── */
    --sh-xs: 0 1px 3px rgba(30, 41, 59, .06);
    --sh-sm: 0 4px 12px rgba(30, 41, 59, .08);
    --sh-md: 0 16px 40px rgba(30, 41, 59, .10);
    --sh-lg: 0 32px 80px rgba(30, 41, 59, .14);
    --glow-blue: 0 8px 32px rgba(37, 99, 235, .25);
    --glow-cyan: 0 8px 32px rgba(8, 145, 178, .25);

    --font-sans: "Inter", system-ui, sans-serif;
    --font-display: "Space Grotesk", "Inter", sans-serif;
    --font-serif: "Lora", "Georgia", serif;

    color-scheme: light;
  }

  /* ═══════ BASE ═══════ */
  html { scroll-behavior: smooth; background: var(--c-bg); }
  body {
    font-family: var(--font-sans);
    background:
      radial-gradient(1000px 500px at 85% -5%, rgba(59,130,246,.08), transparent 55%),
      radial-gradient(700px 400px at 10% 30%, rgba(124,58,237,.05), transparent 60%),
      radial-gradient(600px 300px at 50% 90%, rgba(8,145,178,.05), transparent 60%),
      var(--c-bg);
    color: var(--c-ink);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    -webkit-tap-highlight-color: transparent;
    min-height: 100vh;
    letter-spacing: -0.005em;
  }
  ::selection { background: var(--c-electric); color: #fff; }

  * { scrollbar-color: var(--c-line) transparent; scrollbar-width: thin; }
  *::-webkit-scrollbar { width: 10px; }
  *::-webkit-scrollbar-thumb { background: var(--c-line); border-radius: 999px; border: 2px solid var(--c-bg); }
  *::-webkit-scrollbar-thumb:hover { background: var(--c-electric); }

  /* ═══════ TYPOGRAPHY ═══════ */
  h1, h2, h3 { font-family: var(--font-display); letter-spacing: -0.03em; }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.625rem, 3.4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--c-ink-strong);
    margin-bottom: .625rem;
    line-height: 1.1;
  }
  .section-title .accent {
    background: linear-gradient(110deg, var(--c-cyan) 0%, var(--c-electric) 50%, var(--c-violet) 100%);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
    font-style: italic;
  }
  .section-sub { color: var(--c-muted); max-width: 40rem; margin-bottom: 2rem; font-size: .9375rem; line-height: 1.7; }

  .kicker {
    display: inline-flex; align-items: center; gap: .5rem;
    font-size: .6875rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.22em;
    color: var(--c-electric); margin-bottom: 1rem;
  }
  .kicker::before {
    content: ""; width: 24px; height: 1px;
    background: linear-gradient(90deg, var(--c-electric), transparent);
  }

  .hero-gradient {
    background: linear-gradient(110deg, var(--c-cyan) 0%, var(--c-electric) 45%, var(--c-violet) 100%);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
    font-style: italic;
  }

  /* ═══════ BUTTONS ═══════ */
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: .5rem;
    padding: .9375rem 1.625rem; border-radius: 999px;
    font-weight: 600; font-size: .875rem;
    letter-spacing: -0.005em;
    transition: transform .2s cubic-bezier(.4,0,.2,1), box-shadow .25s, background .2s, filter .2s, border-color .2s;
    position: relative;
    white-space: nowrap;
  }
  .btn:active { transform: scale(.96); }

  .btn-primary {
    background: linear-gradient(135deg, var(--c-electric) 0%, var(--c-cyan) 100%);
    color: #fff;
    font-weight: 700;
    box-shadow: var(--glow-blue), inset 0 1px 0 rgba(255,255,255,.3);
  }
  .btn-primary:hover {
    filter: brightness(1.08);
    box-shadow: 0 12px 40px rgba(37,99,235,.4), inset 0 1px 0 rgba(255,255,255,.35);
    transform: translateY(-1px);
  }

  .btn-ghost {
    background: var(--c-surface);
    color: var(--c-ink-strong);
    border: 1px solid var(--c-line);
    box-shadow: var(--sh-xs);
  }
  .btn-ghost:hover {
    background: var(--c-surface-2);
    border-color: var(--c-electric);
    transform: translateY(-1px);
    box-shadow: var(--sh-sm);
  }

  .btn-wa {
    background: var(--c-wa); color: #fff;
    box-shadow: 0 8px 24px rgba(34,197,94,.35);
  }
  .btn-wa:hover { filter: brightness(1.06); transform: translateY(-1px); }

  .btn-cyan {
    background: var(--c-cyan); color: #fff;
    box-shadow: var(--glow-cyan);
  }
  .btn-cyan:hover { filter: brightness(1.1); transform: translateY(-1px); }

  .btn-soft {
    background: var(--c-surface-2); color: var(--c-ink-strong);
    border: 1px solid var(--c-line);
  }
  .btn-soft:hover { background: var(--c-surface); border-color: var(--c-electric); }

  /* ═══════ DOT PATTERN ═══════ */
  .dot-bg { position: relative; isolation: isolate; }
  .dot-bg::before {
    content: "";
    position: absolute; inset: 0; z-index: -1;
    background-image: radial-gradient(circle, rgba(37,99,235,.08) 1px, transparent 1px);
    background-size: 24px 24px;
    mask-image: radial-gradient(ellipse 85% 65% at 50% 40%, black 15%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 85% 65% at 50% 40%, black 15%, transparent 80%);
    pointer-events: none;
  }
  .dot-grid-strong::before {
    background-image: radial-gradient(circle, rgba(37,99,235,.14) 1.3px, transparent 1.3px);
    background-size: 20px 20px;
  }

  /* ═══════ CARDS ═══════ */
  .card {
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--r-md);
    box-shadow: var(--sh-sm);
    position: relative;
    transition: border-color .3s, transform .3s, box-shadow .3s;
    overflow: hidden;
  }
  .card:hover {
    border-color: rgba(37,99,235,.4);
    transform: translateY(-2px);
    box-shadow: var(--sh-md);
  }

  .card-dot::before {
    content: "";
    position: absolute; top: 14px; right: 14px;
    width: 36px; height: 36px;
    background-image: radial-gradient(circle, rgba(37,99,235,.35) 1px, transparent 1px);
    background-size: 7px 7px;
    border-radius: 6px; opacity: .5;
    pointer-events: none;
  }

  .card-rekening {
    background:
      radial-gradient(500px 250px at 100% 0%, rgba(8,145,178,.1), transparent 55%),
      radial-gradient(400px 200px at 0% 100%, rgba(124,58,237,.08), transparent 55%),
      linear-gradient(155deg, var(--c-surface) 0%, var(--c-surface-2) 100%);
    border: 1px solid rgba(37,99,235,.25);
    border-radius: var(--r-md);
    box-shadow: var(--glow-blue), var(--sh-md);
    position: relative; overflow: hidden;
  }
  .card-rekening > * { position: relative; z-index: 1; }

  /* ═══════ BRAND PILL ═══════ */
  .brand-pill {
    width: 2.5rem; height: 2.5rem; border-radius: .875rem;
    background: linear-gradient(135deg, var(--c-electric), var(--c-cyan) 60%, var(--c-violet));
    display: grid; place-items: center;
    color: #fff; font-weight: 800; font-size: 1.125rem;
    box-shadow: 0 4px 20px rgba(37,99,235,.4), inset 0 1px 0 rgba(255,255,255,.3);
    position: relative;
    flex-shrink: 0;
  }

  /* ═══════ HERO BADGE ═══════ */
  .hero-badge {
    display: inline-flex; align-items: center; gap: .625rem;
    padding: .5rem 1.125rem; border-radius: 999px;
    background: linear-gradient(135deg, rgba(8,145,178,.08), rgba(37,99,235,.05));
    border: 1px solid rgba(37,99,235,.3);
    color: var(--c-electric);
    font-size: .6875rem; font-weight: 700; letter-spacing: .15em;
    margin-bottom: 1.5rem;
    box-shadow: 0 4px 16px rgba(37,99,235,.1);
  }
  .hero-badge::before {
    content: ""; width: 6px; height: 6px;
    border-radius: 50%; background: var(--c-electric);
    box-shadow: 0 0 8px var(--c-electric);
    animation: pulse-dot 2s ease-in-out infinite;
  }
  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: .5; transform: scale(.85); }
  }

  /* ═══════ CTA BANNER ═══════ */
  .cta-banner {
    background:
      radial-gradient(700px 350px at 50% -30%, rgba(8,145,178,.12), transparent 60%),
      radial-gradient(600px 300px at 100% 100%, rgba(124,58,237,.08), transparent 60%),
      radial-gradient(600px 300px at 0% 100%, rgba(37,99,235,.08), transparent 60%),
      linear-gradient(160deg, var(--c-surface) 0%, var(--c-surface-2) 100%);
    border: 1px solid rgba(37,99,235,.2);
    border-radius: var(--r-xl);
    padding: 4rem 2rem;
    text-align: center;
    color: var(--c-ink);
    box-shadow: var(--sh-lg);
    position: relative;
    overflow: hidden;
  }
  .cta-banner::before {
    content: ""; position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(37,99,235,.06) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: radial-gradient(circle at 50% 50%, black, transparent 70%);
    -webkit-mask-image: radial-gradient(circle at 50% 50%, black, transparent 70%);
    pointer-events: none;
  }
  .cta-banner > * { position: relative; z-index: 1; }

  /* ═══════ FOOTER ═══════ */
  .site-footer {
    background: linear-gradient(180deg, var(--c-bg-alt), var(--c-bg));
    border-top: 1px solid var(--c-line);
    color: var(--c-muted);
    padding: 3rem 0 2rem;
    font-size: .875rem;
    position: relative;
  }
  .site-footer a { color: var(--c-muted); transition: color .2s; }
  .site-footer a:hover { color: var(--c-electric); }
  .footer-title {
    color: var(--c-ink-strong);
    font-weight: 700;
    margin-bottom: .875rem;
    font-size: .75rem;
    text-transform: uppercase;
    letter-spacing: .12em;
    font-family: var(--font-display);
  }
  .footer-bottom {
    border-top: 1px solid var(--c-line);
    margin-top: 2rem; padding-top: 1.5rem;
    text-align: center; font-size: .75rem;
    color: var(--c-faint);
  }

  /* ═══════ FLOATING WA ═══════ */
  .wa-float {
    position: fixed; right: 1.25rem; bottom: 5.75rem;
    z-index: 40; width: 3.75rem; height: 3.75rem;
    border-radius: 999px; background: var(--c-wa);
    color: #fff;
    display: grid; place-items: center;
    box-shadow: 0 12px 32px rgba(34,197,94,.4), inset 0 1px 0 rgba(255,255,255,.25);
    animation: wa-pulse 2.4s infinite;
    transition: transform .2s;
  }
  .wa-float:hover { transform: scale(1.08); }
  @keyframes wa-pulse {
    0%,100% { box-shadow: 0 12px 32px rgba(34,197,94,.4), inset 0 1px 0 rgba(255,255,255,.25); }
    50%     { box-shadow: 0 12px 32px rgba(34,197,94,.7), 0 0 0 14px rgba(34,197,94,.08), inset 0 1px 0 rgba(255,255,255,.25); }
  }
  @media (min-width: 768px) { .wa-float { bottom: 1.5rem; } }

  /* ═══════ LINE CLAMP ═══════ */
  .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .line-clamp-3 { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

  /* ═══════ ARTICLE READING TYPOGRAPHY ═══════ */
  .article-content {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    line-height: 1.85;
    color: var(--c-ink);
    letter-spacing: 0.002em;
  }
  .article-content > * + * { margin-top: 1.4rem; }

  .article-content h2 {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--c-ink-strong);
    margin-top: 3rem;
    margin-bottom: 0.875rem;
    letter-spacing: -0.025em;
    line-height: 1.25;
    padding-top: 0.5rem;
  }
  .article-content h2::before {
    content: "";
    display: block;
    width: 32px;
    height: 3px;
    background: linear-gradient(90deg, var(--c-electric), var(--c-cyan));
    border-radius: 2px;
    margin-bottom: 1rem;
  }

  .article-content h3 {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--c-ink-strong);
    margin-top: 2.25rem;
    margin-bottom: 0.625rem;
    letter-spacing: -0.02em;
  }

  .article-content p { color: var(--c-ink); }
  .article-content p + p { margin-top: 1.4rem; }
  .article-content strong { color: var(--c-ink-strong); font-weight: 700; }
  .article-content em {
    color: var(--c-electric);
    font-style: italic;
    font-weight: 500;
  }

  .article-content ul {
    padding-left: 1.5rem;
    list-style: none;
    margin-block: 1.5rem;
  }
  .article-content ul li {
    position: relative;
    padding-left: 1rem;
    color: var(--c-ink);
    margin-bottom: 0.75rem;
    line-height: 1.75;
  }
  .article-content ul li::before {
    content: "▸";
    position: absolute;
    left: 0;
    color: var(--c-electric);
    font-weight: 700;
    font-family: var(--font-sans);
  }

  .article-content ol {
    padding-left: 1.5rem;
    list-style: decimal;
    margin-block: 1.5rem;
  }
  .article-content ol li {
    color: var(--c-ink);
    margin-bottom: 0.75rem;
    padding-left: 0.5rem;
  }
  .article-content ol li::marker {
    color: var(--c-electric);
    font-weight: 700;
  }

  .article-content a {
    color: var(--c-electric);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: color .2s;
  }
  .article-content a:hover { color: var(--c-cyan); }

  .article-content blockquote {
    border-left: 3px solid var(--c-electric);
    padding-left: 1.5rem;
    margin-block: 1.75rem;
    font-style: italic;
    color: var(--c-ink);
    font-size: 1.125rem;
    background: rgba(37,99,235,.03);
    padding-block: 0.5rem;
    border-radius: 4px;
  }

  .article-content code {
    font-family: ui-monospace, "Courier New", monospace;
    font-size: 0.9em;
    background: var(--c-surface-2);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    color: var(--c-electric);
    border: 1px solid var(--c-line);
  }

  .article-content pre {
    background: var(--c-surface-2);
    border: 1px solid var(--c-line);
    border-radius: var(--r-sm);
    padding: 1rem 1.25rem;
    overflow-x: auto;
    margin-block: 1.75rem;
  }
  .article-content pre code {
    background: none;
    border: none;
    padding: 0;
    color: var(--c-ink);
  }

  .article-content hr {
    border: none;
    border-top: 1px solid var(--c-line);
    margin-block: 2.5rem;
  }

  .article-content img {
    border-radius: var(--r-md);
    margin-block: 1.75rem;
    box-shadow: var(--sh-md);
  }
</style>