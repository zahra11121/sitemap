---
import Layout from '../layouts/Layout.astro';

// Master Data Perusahaan
const companyData = {
  name: "CV Green Fresh Cipanas",
  npwp: "93.038.709.7-406.000",
  address: "Kp. Kayumanis, RT 001 / RW 006, Kel. Sukatani, Kec. Pacet, Kab. Cianjur, Jawa Barat",
  phone: "087780937884",
  waNumber: "6287780937884",
  email: "cs@greenfresh.co.id",
  bank: {
    name: "BCA",
    branch: "KCP Cipanas",
    accountName: "Green Fresh Cipanas",
    accountNumber: "1978400999"
  }
};

// SEO Metadata
const siteUrl = "https://greenfresh.co.id";
const pageUrl = `${siteUrl}/syarat-ketentuan`;
const pageTitle = "Syarat & Ketentuan B2B — CV Green Fresh Cipanas";
const pageDescription = "Syarat dan ketentuan resmi pasokan komoditas pertanian & sayur segar B2B CV Green Fresh Cipanas. Informasi minimal order, termin pembayaran 7 hari, dan garansi retur.";

// JSON-LD Schema (WebPage + BreadcrumbList)
const jsonLdSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${pageUrl}/#webpage`,
      "url": pageUrl,
      "name": pageTitle,
      "description": pageDescription,
      "inLanguage": "id-ID",
      "isPartOf": { "@id": `${siteUrl}/#website` },
      "breadcrumb": { "@id": `${pageUrl}/#breadcrumb` }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}/#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Beranda", "item": siteUrl },
        { "@type": "ListItem", "position": 2, "name": "Syarat & Ketentuan", "item": pageUrl }
      ]
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageUrl}
>
  <!-- ================= SEO HEAD ================= -->
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdSchema)} />
  </Fragment>

  <!-- HERO HEADER -->
  <section class="relative pt-12 pb-16 md:pt-20 md:pb-24 bg-gradient-to-br from-emerald-950 via-emerald-900 to-slate-950 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <!-- Breadcrumb UX -->
      <nav aria-label="Breadcrumb" class="mb-4">
        <ol class="inline-flex items-center space-x-2 text-xs text-emerald-200/80">
          <li><a href="/" class="hover:text-white transition-colors">Beranda</a></li>
          <li><span>/</span></li>
          <li class="text-emerald-400 font-semibold" aria-current="page">Syarat & Ketentuan</li>
        </ol>
      </nav>

      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-white via-emerald-100 to-teal-200">
        Syarat & Ketentuan Kerjasama B2B
      </h1>
      <p class="mt-3 text-xs sm:text-base text-emerald-100/80 max-w-2xl mx-auto leading-relaxed">
        Ketentuan resmi pasokan komoditas pertanian, sistem transaksi, termin pembayaran, dan kebijakan garansi layanan CV Green Fresh Cipanas.
      </p>
    </div>
  </section>

  <!-- CONTENT SECTION -->
  <section class="py-12 md:py-20 bg-slate-50 border-b border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="bg-white p-6 md:p-12 rounded-3xl border border-slate-200 shadow-xl space-y-10 text-slate-700 text-sm md:text-base leading-relaxed">

        <!-- Info Legalitas Perusahaan -->
        <div class="p-5 rounded-2xl bg-emerald-50/60 border border-emerald-200/60 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
          <div>
            <h2 class="text-base md:text-lg font-extrabold text-slate-900">{companyData.name}</h2>
            <p class="text-xs text-slate-500 font-mono mt-0.5">NPWP: {companyData.npwp}</p>
          </div>
          <span class="px-3 py-1 bg-emerald-600 text-white font-bold text-[11px] rounded-full uppercase tracking-wider">
            Dokumen Kerjasama Resmi
          </span>
        </div>

        <!-- Pasal 1: Ketentuan Pemesanan -->
        <div class="space-y-3">
          <h3 class="text-lg md:text-xl font-extrabold text-slate-900 flex items-center gap-2">
            <span class="w-7 h-7 rounded-lg bg-emerald-100 text-emerald-800 text-xs font-black flex items-center justify-center">1</span>
            Ketentuan Minimum Order & Pemesanan (MOV)
          </h3>
          <ul class="list-disc pl-6 space-y-2 text-slate-600">
            <li>Minimal nilai transaksi per pengiriman (Minimum Order Value / MOV) adalah <strong>Rp 1.500.000,- (Satu Juta Lima Ratus Ribu Rupiah)</strong>.</li>
            <li>Pemesanan dilakukan paling lambat <strong>H-1 (24 jam sebelum pengiriman)</strong> maksimal pukul 17.00 WIB melalui Formulir WhatsApp / Sistem Customer Service kami.</li>
            <li>Pemesanan yang masuk di atas pukul 17.00 WIB akan diproses untuk jadwal pengiriman H+2.</li>
          </ul>
        </div>

        <hr class="border-slate-100" />

        <!-- Pasal 2: Termin Pembayaran (TOP) -->
        <div class="space-y-3">
          <h3 class="text-lg md:text-xl font-extrabold text-slate-900 flex items-center gap-2">
            <span class="w-7 h-7 rounded-lg bg-emerald-100 text-emerald-800 text-xs font-black flex items-center justify-center">2</span>
            Sistem & Termin Pembayaran (TOP 7 Hari)
          </h3>
          <ul class="list-disc pl-6 space-y-2 text-slate-600">
            <li><strong>Mitra Baru:</strong> 3 (tiga) kali transaksi pertama dilakukan secara <em>Cash / Transfer Harian (CBD/COD)</em> saat barang diterima.</li>
            <li><strong>Fasilitas TOP 7 Hari:</strong> Berlaku untuk mitra korporasi terdaftar (Hotel, Restoran, Supermarket, Rumah Sakit, Katering Pabrik) setelah menyerahkan dokumen legalitas usaha (NIB / NPWP).</li>
            <li>Tagihan (Invoicing) diterbitkan sesuai tanggal surat jalan penerimaan barang dan jatuh tempo dalam waktu 7 (tujuh) hari kalender.</li>
            <li>Seluruh pembayaran transfer <strong>wajib dikirimkan ke rekening resmi perusahaan</strong>:
              <div class="mt-2 p-4 rounded-xl bg-slate-900 text-white font-mono text-xs md:text-sm space-y-1">
                <p class="text-emerald-400 font-bold">{companyData.bank.name} — {companyData.bank.branch}</p>
                <p class="text-lg font-black">{companyData.bank.accountNumber}</p>
                <p class="text-slate-300">a/n {companyData.bank.accountName}</p>
              </div>
            </li>
          </ul>
        </div>

        <hr class="border-slate-100" />

        <!-- Pasal 3: Standar Kualitas & Garansi Retur -->
        <div class="space-y-3">
          <h3 class="text-lg md:text-xl font-extrabold text-slate-900 flex items-center gap-2">
            <span class="w-7 h-7 rounded-lg bg-emerald-100 text-emerald-800 text-xs font-black flex items-center justify-center">3</span>
            Standar Kualitas & Garansi Retur 100%
          </h3>
          <ul class="list-disc pl-6 space-y-2 text-slate-600">
            <li>Setiap komoditas dipanen langsung dari kebun Cipanas & Puncak serta melewati sortir <em>Quality Control (QC) Grade A</em>.</li>
            <li><strong>Garansi Retur 100%:</strong> Klaim kerusakan, busuk, atau komoditas tidak sesuai spesifikasi dapat diajukan maksimal <strong>24 jam setelah penerimaan barang</strong>.</li>
            <li>Klaim wajib menyertakan foto/video bukti produk yang rusak serta dokumen Nota / Surat Jalan penerimaan.</li>
            <li>Penggantian barang yang diretur akan dikirimkan pada jadwal pengiriman harian berikutnya atau dipotong langsung pada tagihan invoice.</li>
          </ul>
        </div>

        <hr class="border-slate-100" />

        <!-- Pasal 4: Pengiriman & Logistik -->
        <div class="space-y-3">
          <h3 class="text-lg md:text-xl font-extrabold text-slate-900 flex items-center gap-2">
            <span class="w-7 h-7 rounded-lg bg-emerald-100 text-emerald-800 text-xs font-black flex items-center justify-center">4</span>
            Pengiriman & Jadwal Armada
          </h3>
          <ul class="list-disc pl-6 space-y-2 text-slate-600">
            <li>Pengiriman dilakukan menggunakan armada pendingin / kendaraan khusus pengangkut komoditas tani harian.</li>
            <li>Wilayah cakupan pengiriman meliputi: Jabodetabek, Cianjur, Bogor, Sukabumi, dan Bandung Raya.</li>
            <li>Mitra penerima wajib menyediakan area *receiving* yang memadai dan menunjuk staf penanggung jawab penerimaan barang saat pengiriman tiba.</li>
          </ul>
        </div>

        <!-- CTA Hubungi Admin -->
        <div class="p-6 rounded-2xl bg-gradient-to-r from-emerald-900 to-teal-900 text-white text-center space-y-3">
          <h4 class="font-extrabold text-base md:text-lg">Butuh Informasi / Pengajuan Kerjasama Khusus?</h4>
          <p class="text-xs md:text-sm text-emerald-100/80">Tim admin B2B kami siap membantu verifikasi dokumen & penawaran harga terbaik.</p>
          <a
            href={`https://wa.me/${companyData.waNumber}?text=Halo%20CV%20Green%20Fresh%20Cipanas,%20saya%20ingin%20bertanya%20mengenai%20syarat%20kerjasama%20B2B.`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-emerald-400 text-slate-950 font-extrabold text-xs md:text-sm hover:bg-emerald-300 transition-all shadow-lg"
          >
            Hubungi Customer Service (WhatsApp)
          </a>
        </div>

      </div>

    </div>
  </section>
</Layout>