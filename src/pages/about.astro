---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

// Menggunakan salah satu aset gambar produk galeri untuk ilustrasi about
import Brokoli_2 from '../assets/products/Brokoli_2.jpg';

const companyData = {
  name: "CV Green Fresh Cipanas",
  npwp: "93.038.709.7-406.000",
  address: "Kp. Kayumanis, RT 001 / RW 006, Kel. Sukatani, Kec. Pacet, Kab. Cianjur, Jawa Barat",
  phone: "087780937884",
  waNumber: "6287780937884",
  bank: {
    name: "BCA",
    branch: "KCP Cipanas",
    accountName: "Green Fresh Cipanas",
    accountNumber: "1978400999"
  }
};
---

<Layout title="Tentang Kami — CV Green Fresh Cipanas">

  <!-- HERO SECTION ABOUT -->
  <section class="relative pt-12 pb-16 md:pt-24 md:pb-32 overflow-hidden bg-gradient-to-br from-emerald-950 via-emerald-900 to-slate-950 text-white select-none">
    <div class="absolute -top-40 -left-40 w-96 h-96 bg-emerald-500/20 rounded-full blur-3xl animate-pulse pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 animate-fade-in-up">
      <div class="inline-block">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/20 border border-emerald-400/30 text-emerald-300 text-xs md:text-sm font-semibold mb-4 backdrop-blur-md shadow-lg">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span> Profil Resmi Perusahaan B2B
        </span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-tight max-w-4xl mx-auto text-transparent bg-clip-text bg-gradient-to-r from-white via-emerald-100 to-teal-200">
        Mengenal Lebih Dekat CV Green Fresh Cipanas
      </h1>

      <p class="mt-3 text-xs sm:text-lg text-emerald-100/80 max-w-2xl mx-auto font-light leading-relaxed">
        Pemasok utama komoditas pertanian, sayur mayur segar, jamur, dan hasil bumi berkualitas tinggi langsung dari dataran tinggi Cipanas & Puncak.
      </p>
    </div>
  </section>

  <!-- MAIN CONTENT SECTION WITH GALLERY IMAGE -->
  <section class="py-12 md:py-24 bg-gradient-to-b from-emerald-50/60 via-teal-50/40 to-white border-b border-emerald-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        
        <!-- Kolom Gambar Galeri dengan Efek Visual Menarik -->
        <div class="relative group">
          <div class="absolute -inset-2 bg-gradient-to-r from-emerald-600 to-teal-500 rounded-3xl blur-xl opacity-30 group-hover:opacity-50 transition duration-500"></div>
          <div class="relative rounded-3xl overflow-hidden border border-emerald-200 shadow-2xl bg-white aspect-[4/3]">
            <Image 
              src={Brokoli_2} 
              alt="Kebun dan Produk Segar CV Green Fresh Cipanas" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent flex items-end p-6">
              <div class="text-white">
                <p class="text-xs uppercase font-extrabold tracking-wider text-emerald-300">Quality Control Grade A</p>
                <p class="text-sm md:text-base font-bold mt-0.5">Dipanen Segar dari Petani Lokal Cipanas & Puncak</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Kolom Teks Deskripsi Detail -->
        <div class="space-y-6">
          <div>
            <span class="inline-block px-3.5 py-1 rounded-full bg-emerald-100 text-emerald-800 font-extrabold text-xs tracking-wider uppercase mb-2">Sejarah & Komitmen</span>
            <h2 class="text-2xl md:text-4xl font-extrabold text-slate-900 tracking-tight">Mitra Terpercaya Pasokan Sayuran Hotel & Restoran</h2>
          </div>
          
          <p class="text-slate-600 text-sm md:text-base leading-relaxed">
            <strong>CV Green Fresh Cipanas</strong> beroperasi di kawasan Pacet, Cianjur, Jawa Barat. Kami memfokuskan diri sebagai penyedia pasokan pangan B2B (Business-to-Business) untuk hotel, restoran, kafe, katering, dan supermarket yang mengutamakan standar kesegaran prima.
          </p>

          <p class="text-slate-600 text-sm md:text-base leading-relaxed">
            Dengan dukungan penuh dari jaringan petani lokal di dataran tinggi Cipanas dan Puncak, setiap produk mulai dari sayuran hijau, umbi-umbian, jamur, hingga bumbu rempah melalui proses seleksi ketat sebelum dikirimkan kepada para mitra bisnis.
          </p>

          <div class="grid grid-cols-2 gap-4 pt-4 border-t border-emerald-200/60">
            <div class="p-4 bg-white rounded-2xl border border-emerald-100 shadow-sm">
              <p class="text-2xl md:text-3xl font-extrabold text-emerald-600">60+</p>
              <p class="text-xs text-slate-500 font-medium">Jenis Komoditas Ready</p>
            </div>
            <div class="p-4 bg-white rounded-2xl border border-emerald-100 shadow-sm">
              <p class="text-2xl md:text-3xl font-extrabold text-emerald-600">7 Hari</p>
              <p class="text-xs text-slate-500 font-medium">Termin Pembayaran B2B (TOP)</p>
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- VISI & MISI SECTION -->
  <section class="py-12 md:py-24 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="inline-block px-3.5 py-1 rounded-full bg-emerald-100 text-emerald-800 font-extrabold text-xs tracking-wider uppercase mb-2">Landasan Kerja</span>
        <h2 class="text-2xl md:text-4xl font-extrabold text-slate-900 tracking-tight">Visi & Misi Perusahaan</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Visi -->
        <div class="p-6 md:p-8 bg-emerald-50/70 rounded-3xl border border-emerald-200 shadow-sm hover:shadow-md transition-all">
          <div class="flex items-center gap-3.5 mb-4">
            <div class="w-10 h-10 rounded-2xl bg-emerald-600 text-white flex items-center justify-center font-bold text-base shadow-lg">👁️</div>
            <h3 class="text-xl font-extrabold text-slate-900">Visi Kami</h3>
          </div>
          <p class="text-slate-700 text-sm md:text-base leading-relaxed">
            Menjadi mitra utama supplier hasil tani dan sayuran terdepan di Indonesia yang terpercaya dalam mutu kesegaran, kontinuitas pasokan, serta profesionalisme layanan B2B.
          </p>
        </div>

        <!-- Misi -->
        <div class="p-6 md:p-8 bg-teal-50/70 rounded-3xl border border-teal-200 shadow-sm hover:shadow-md transition-all">
          <div class="flex items-center gap-3.5 mb-4">
            <div class="w-10 h-10 rounded-2xl bg-teal-600 text-white flex items-center justify-center font-bold text-base shadow-lg">🎯</div>
            <h3 class="text-xl font-extrabold text-slate-900">Misi Kami</h3>
          </div>
          <ul class="space-y-3 text-slate-700 text-sm md:text-base leading-relaxed">
            <li class="flex items-start gap-2.5">
              <span class="text-teal-600 font-extrabold mt-0.5">•</span>
              <span>Menjamin distribusi produk pertanian segar berkualitas Grade A langsung dari petani lokal Cipanas & Puncak.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-teal-600 font-extrabold mt-0.5">•</span>
              <span>Memberikan kepastian jadwal pengiriman yang konsisten untuk kelancaran operasional mitra hotel dan restoran.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-teal-600 font-extrabold mt-0.5">•</span>
              <span>Membangun kerjasama jangka panjang dengan fleksibilitas sistem pembayaran B2B (TOP 7 Hari).</span>
            </li>
          </ul>
        </div>
      </div>

    </div>
  </section>

  <!-- LOKASI, ALAMAT & PETA GOOGLE MAPS SECTION -->
  <section class="py-12 md:py-24 bg-slate-100 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <span class="inline-block px-3.5 py-1 rounded-full bg-emerald-100 text-emerald-800 font-extrabold text-xs tracking-wider uppercase mb-2">Lokasi Operasional</span>
        <h2 class="text-2xl md:text-4xl font-extrabold text-slate-900 tracking-tight">Alamat Gudang & Kebun Kami</h2>
        <p class="text-slate-600 text-xs md:text-sm mt-2">Kunjungi gudang atau lokasi pengumpulan hasil tani kami di Cipanas.</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
        
        <!-- Informasi Alamat & Kontak Box -->
        <div class="bg-white p-6 md:p-10 rounded-3xl border border-slate-200 shadow-xl flex flex-col justify-between space-y-6">
          <div>
            <span class="inline-block px-3.5 py-1 rounded-full bg-slate-200 text-slate-800 font-extrabold text-[10px] md:text-xs uppercase tracking-wider mb-2">Legalitas & Kontak</span>
            <h3 class="text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight">{companyData.name}</h3>
            <p class="text-xs text-slate-500 mt-1">NPWP Resmi: <span class="font-mono font-bold text-slate-700">{companyData.npwp}</span></p>
          </div>

          <div class="space-y-4 text-xs md:text-sm text-slate-600">
            <div class="flex items-start gap-3.5 p-3 rounded-2xl bg-slate-50 border border-slate-100">
              <div class="w-9 h-9 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center flex-shrink-0 font-bold">📍</div>
              <div>
                <strong class="text-slate-900">Alamat Lengkap:</strong>
                <p class="mt-0.5">{companyData.address}</p>
              </div>
            </div>

            <div class="flex items-center gap-3.5 p-3 rounded-2xl bg-slate-50 border border-slate-100">
              <div class="w-9 h-9 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center flex-shrink-0 font-bold">📞</div>
              <div>
                <strong class="text-slate-900">Telepon / WhatsApp Admin:</strong>
                <p class="mt-0.5">
                  <a href={`https://wa.me/${companyData.waNumber}`} class="text-emerald-700 font-extrabold hover:underline">
                    {companyData.phone}
                  </a>
                </p>
              </div>
            </div>
          </div>

          <!-- Bank Rekening Card -->
          <div class="p-5 md:p-6 rounded-2xl bg-gradient-to-r from-emerald-950 to-emerald-900 text-white space-y-2 relative overflow-hidden shadow-lg">
            <div class="absolute -right-4 -bottom-4 w-32 h-32 bg-emerald-700/30 rounded-full blur-2xl"></div>
            <p class="text-[10px] md:text-xs text-emerald-300 font-extrabold uppercase tracking-widest">Rekening Resmi Transaksi</p>
            <div class="flex justify-between items-center pt-1 relative z-10">
              <div>
                <p class="text-xs text-emerald-100 font-medium">{companyData.bank.name} — {companyData.bank.branch}</p>
                <p class="text-xl md:text-2xl font-mono font-extrabold tracking-wider text-emerald-300 mt-0.5">{companyData.bank.accountNumber}</p>
                <p class="text-xs text-emerald-100 mt-0.5">a/n <strong>{companyData.bank.accountName}</strong></p>
              </div>
              <div class="bg-white/15 px-3.5 py-1.5 rounded-xl border border-white/20 text-xs font-black tracking-wider text-white backdrop-blur-md">
                BCA
              </div>
            </div>
          </div>
        </div>

        <!-- Google Maps Embed Box -->
        <div class="bg-white p-4 md:p-6 rounded-3xl border border-slate-200 shadow-xl flex flex-col justify-between overflow-hidden">
          <div class="mb-3 px-2">
            <h3 class="font-extrabold text-slate-900 text-lg md:text-xl">Peta Petunjuk Direction</h3>
            <p class="text-xs text-slate-500 font-medium">Sukatani, Pacet, Kabupaten Cianjur, Jawa Barat</p>
          </div>
          <div class="w-full h-80 md:h-[380px] rounded-2xl overflow-hidden border border-slate-200 shadow-inner">
            <iframe 
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3962.207870561313!2d107.0236364!3d-6.7444817!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e69b3dec98fb5cf%3A0xa1a6070b0a2a9ef3!2sCV%20Green%20Fresh%20Cipanas%20-%20Supplier%20Sayur%20Mayur!5e0!3m2!1sid!2sid!4v1792404928345!5m2!1sid!2sid" 
              width="100%" 
              height="100%" 
              style="border:0;" 
              allowfullscreen="" 
              loading="lazy" 
              referrerpolicy="strict-origin-when-cross-origin"
            ></iframe>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- CALL TO ACTION SECTION -->
  <section class="py-12 md:py-20 bg-gradient-to-r from-emerald-950 via-emerald-900 to-slate-950 text-white text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <h2 class="text-2xl md:text-4xl font-extrabold tracking-tight">Siap Bermitra dengan CV Green Fresh Cipanas?</h2>
      <p class="text-emerald-100/80 text-xs md:text-base max-w-xl mx-auto">
        Dapatkan penawaran harga grosir terbaik dan kepastian pasokan sayur segar harian untuk usaha Anda.
      </p>
      <div class="pt-2 flex flex-col sm:flex-row gap-3 justify-center items-center">
        <a href="/#order-form" class="px-8 py-3.5 rounded-2xl bg-emerald-400 text-slate-950 font-extrabold text-xs md:text-sm shadow-xl hover:bg-emerald-300 active:scale-95 transition-all">
          Form Order Grosir
        </a>
        <a href={`https://wa.me/${companyData.waNumber}`} target="_blank" class="px-8 py-3.5 rounded-2xl bg-white/10 border border-white/20 text-white font-bold text-xs md:text-sm backdrop-blur-md hover:bg-white/20 active:scale-95 transition-all">
          Hubungi WhatsApp Admin
        </a>
      </div>
    </div>
  </section>

</Layout>