  <!-- CLIENT INTERACTIVE SCRIPTS -->
  <script>
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const filterBtns = document.querySelectorAll('.filter-btn');
    const productCards = document.querySelectorAll('.product-card');
    const emptyState = document.getElementById('empty-state');
    const loadMoreBtn = document.getElementById('load-more-btn');
    const loadMoreContainer = document.getElementById('load-more-container');
    const countInfo = document.getElementById('product-count-info');

    let currentCategory = 'Semua';
    let currentSearch = '';
    let visibleLimit = 8;

    function renderProducts() {
      let matchingCards: HTMLElement[] = [];

      productCards.forEach((card) => {
        const el = card as HTMLElement;
        const name = el.dataset.name || '';
        const category = el.dataset.category || '';

        const matchesCategory = currentCategory === 'Semua' || category === currentCategory;
        const matchesSearch = name.includes(currentSearch.toLowerCase());

        if (matchesCategory && matchesSearch) {
          matchingCards.push(el);
        } else {
          el.classList.add('hidden');
        }
      });

      if (emptyState) {
        emptyState.style.display = matchingCards.length === 0 ? 'block' : 'none';
      }

      const totalMatching = matchingCards.length;
      
      matchingCards.forEach((el, index) => {
        if (index < visibleLimit) {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });

      if (loadMoreContainer) {
        if (visibleLimit >= totalMatching || totalMatching === 0) {
          loadMoreContainer.style.display = 'none';
        } else {
          loadMoreContainer.style.display = 'block';
        }
      }

      if (countInfo) {
        const currentlyShown = Math.min(visibleLimit, totalMatching);
        countInfo.innerText = `Menampilkan ${currentlyShown} dari ${totalMatching} produk`;
      }
    }

    loadMoreBtn?.addEventListener('click', () => {
      visibleLimit += 8;
      renderProducts();
    });

    searchInput?.addEventListener('input', (e) => {
      currentSearch = (e.target as HTMLInputElement).value;
      visibleLimit = 8;
      renderProducts();
    });

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => {
          b.classList.remove('bg-emerald-600', 'text-white', 'shadow-lg', 'shadow-emerald-600/30', 'active-category', 'scale-105');
          b.classList.add('bg-white', 'text-slate-600', 'border', 'border-slate-200');
        });

        btn.classList.remove('bg-white', 'text-slate-600', 'border', 'border-slate-200');
        btn.classList.add('bg-emerald-600', 'text-white', 'shadow-lg', 'shadow-emerald-600/30', 'active-category', 'scale-105');

        currentCategory = (btn as HTMLElement).dataset.category || 'Semua';
        visibleLimit = 8;
        renderProducts();
      });
    });

    const addBtns = document.querySelectorAll('.add-to-form-btn');
    const komoditasTextarea = document.getElementById('form-komoditas') as HTMLTextAreaElement;

    addBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const pName = (btn as HTMLElement).dataset.productName;
        if (komoditasTextarea && pName) {
          if (!komoditasTextarea.value.includes(pName)) {
            komoditasTextarea.value += (komoditasTextarea.value ? '\n' : '') + `- ${pName}: ... Kg`;
          }
          const orderFormSec = document.getElementById('order-form');
          orderFormSec?.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });

    const waForm = document.getElementById('wa-order-form');
    waForm?.addEventListener('submit', (e) => {
      e.preventDefault();

      const nama = (document.getElementById('form-nama') as HTMLInputElement).value;
      const alamat = (document.getElementById('form-alamat') as HTMLInputElement).value;
      const tgl = (document.getElementById('form-tanggal') as HTMLInputElement).value;
      const bayar = (document.getElementById('form-pembayaran') as HTMLSelectElement).value;
      const komoditas = (document.getElementById('form-komoditas') as HTMLTextAreaElement).value;

      const message = `Halo CV Green Fresh Cipanas, saya ingin memesan pasokan sayur:\n\n` +
                      `*Nama Usaha:* ${nama}\n` +
                      `*Alamat Kirim:* ${alamat}\n` +
                      `*Tgl Kirim:* ${tgl}\n` +
                      `*Metode Bayar:* ${bayar}\n\n` +
                      `*Pesanan (Min. Rp 1.5 Juta):*\n${komoditas}\n\n` +
                      `Mohon info penawaran harganya. Terima kasih.`;

      window.open(`https://wa.me/6287780937884?text=${encodeURIComponent(message)}`, '_blank');
    });

    const faqTriggers = document.querySelectorAll('.faq-trigger');
    faqTriggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const targetId = (trigger as HTMLElement).dataset.target;
        const targetAns = document.getElementById(targetId || '');
        const icon = trigger.querySelector('.faq-icon');

        if (targetAns) {
          const isHidden = targetAns.classList.contains('hidden');
          document.querySelectorAll('.faq-answer').forEach(ans => ans.classList.add('hidden'));
          document.querySelectorAll('.faq-icon').forEach(ic => ic.classList.remove('rotate-180'));

          if (isHidden) {
            targetAns.classList.remove('hidden');
            icon?.classList.add('rotate-180');
          }
        }
      });
    });

    renderProducts();
  </script>

</Layout>