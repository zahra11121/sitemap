            <button
              class={`filter-btn px-4 py-2 rounded-xl text-xs font-bold whitespace-nowrap transition-all duration-300 ${
                index === 0
                  ? 'bg-emerald-600 text-white shadow active-category scale-105'
                  : 'bg-slate-100 text-slate-600 hover:bg-emerald-50 hover:text-emerald-700'
              }`}
