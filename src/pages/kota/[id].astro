          <div
            class={`product-card bg-white rounded-3xl overflow-hidden border border-slate-200/80 shadow-sm transition-all duration-300 hover:shadow-xl hover:scale-[1.02] flex flex-col group ${index >= 8 ? 'hidden' : ''}`}
