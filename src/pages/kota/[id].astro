  <style>
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>

  <script>
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const filterBtns = document.querySelectorAll('.filter-btn');
    const productCards = document.querySelectorAll('.product-card');
    const emptyState = document.getElementById('empty-state');
    const loadMoreBtn = document.getElementById('load-more-btn');
    const loadMoreContainer = document.getElementById('load-more-container');
    const countInfo = document.getElementById('product-count-info');

    let currentCategory = 'Semua';
    let currentSearch = '';
    let visibleLimit = 8;

    function renderProducts() {
      let matchingCards: HTMLElement[] = [];
      productCards.forEach((card) => {
        const el = card as HTMLElement;
        const name = el.dataset.name || '';
        const category = el.dataset.category || '';
        const matchesCategory = currentCategory === 'Semua' || category === currentCategory;
        const matchesSearch = name.includes(currentSearch.toLowerCase());
        if (matchesCategory && matchesSearch) {
          matchingCards.push(el);
        } else {
          el.classList.add('hidden');
        }
      });
      if (emptyState) emptyState.style.display = matchingCards.length === 0 ? 'block' : 'none';
      const totalMatching = matchingCards.length;
      matchingCards.forEach((el, index) => {
        if (index < visibleLimit) el.classList.remove('hidden');
        else el.classList.add('hidden');
      });
      if (loadMoreContainer) loadMoreContainer.style.display = visibleLimit >= totalMatching || totalMatching === 0 ? 'none' : 'block';
      if (countInfo) countInfo.innerText = `Menampilkan ${Math.min(visibleLimit, totalMatching)} dari ${totalMatching} produk`;
    }

    loadMoreBtn?.addEventListener('click', () => { visibleLimit += 8; renderProducts(); });
    searchInput?.addEventListener('input', (e) => { currentSearch = (e.target as HTMLInputElement).value; visibleLimit = 8; renderProducts(); });

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => {
          b.classList.remove('bg-emerald-600', 'text-white', 'shadow', 'active-category', 'scale-105');
          b.classList.add('bg-slate-100', 'text-slate-600');
        });
        btn.classList.remove('bg-slate-100', 'text-slate-600');
        btn.classList.add('bg-emerald-600', 'text-white', 'shadow', 'active-category', 'scale-105');
        currentCategory = (btn as HTMLElement).dataset.category || 'Semua';
        visibleLimit = 8;
        renderProducts();
      });
    });

    document.querySelectorAll('.add-to-form-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const pName = (btn as HTMLElement).dataset.productName;
        const komoditasTextarea = document.getElementById('form-komoditas') as HTMLTextAreaElement;
        if (komoditasTextarea && pName && !komoditasTextarea.value.includes(pName)) {
          komoditasTextarea.value += (komoditasTextarea.value ? '\n' : '') + `- ${pName}: ... Kg`;
          document.getElementById('order-form')?.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });

    document.getElementById('wa-order-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const nama = (document.getElementById('form-nama') as HTMLInputElement).value;
      const alamat = (document.getElementById('form-alamat') as HTMLInputElement).value;
      const tgl = (document.getElementById('form-tanggal') as HTMLInputElement).value;
      const bayar = (document.getElementById('form-pembayaran') as HTMLSelectElement).value;
      const komoditas = (document.getElementById('form-komoditas') as HTMLTextAreaElement).value;
      const message = `Halo CV Green Fresh Cipanas, pesan sayur untuk ${namaLokasi}:\n\n*Usaha:* ${nama}\n*Alamat:* ${alamat}\n*Tgl Kirim:* ${tgl}\n*Bayar:* ${bayar}\n\n*Pesanan:*\n${komoditas}`;
      window.open(`https://wa.me/6287780937884?text=${encodeURIComponent(message)}`, '_blank');
    });

    renderProducts();
  </script>

</Layout>