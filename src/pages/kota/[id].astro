---

<Layout 
  title={`${selectedTitle} — CV Green Fresh Cipanas`}
  description={`Supplier, distributor, dan pemasok sayuran segar di ${namaLokasi} untuk hotel, restoran, rumah sakit, dan pabrik. Garansi Grade A & Termin 7 Hari.`}
>
  <!-- ================= KUMPULAN META, SCHEMA & CANONICAL DI DALAM <HEAD> ================= -->
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdSchema)} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content="CV Green Fresh Cipanas" />
    <meta name="geo.region" content="ID-JB" />
    <meta name="geo.placename" content={namaLokasi} />
    <meta name="geo.position" content="-6.7444817;107.0236364" />
    <meta name="ICBM" content="-6.7444817, 107.0236364" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CV Green Fresh Cipanas" />
    <meta property="og:title" content={`${selectedTitle} — CV Green Fresh Cipanas`} />
    <meta property="og:description" content={`Supplier sayuran segar di ${namaLokasi}. Garansi Grade A, termin 7 hari, armada harian.`} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content="id_ID" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={selectedTitle} />
    <meta name="twitter:description" content={`Pemasok sayuran segar B2B di ${namaLokasi}.`} />
  </Fragment>
  
  <!-- ================= HERO SECTION ================= -->
<section id="hero" class="relative pt-20 pb-28 md:pt-48 md:pb-40 bg-gradient-to-br from-emerald-950 via-slate-900 to-emerald-900 text-white overflow-hidden transition-all duration-300">
  <div class="absolute inset-0 bg-[radial-gradient(#34d399_1px,transparent_1px)] [background-size:24px_24px] opacity-10"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center max-w-4xl mx-auto">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-500/20 border border-emerald-400/30 text-emerald-300 text-xs md:text-sm font-extrabold uppercase tracking-widest mb-6 backdrop-blur-md shadow-lg transition-all duration-300 hover:scale-105">
      <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
      <span>Pusat Pasokan B2B Area {namaLokasi}</span>
    </div>

    <h1 class="text-3xl sm:text-5xl lg:text-7xl font-extrabold tracking-tight leading-snug md:leading-tight text-white mb-6">
      {selectedTitle}
    </h1>

    <p class="text-emerald-100/90 text-sm sm:text-lg leading-relaxed max-w-3xl mx-auto font-light mb-10" set:html={selectedAbout}></p>

    <!-- Jarak ke atas ditambah menggunakan mt-8 -->
    <div class="flex flex-col sm:flex-row justify-center gap-5 mt-8">
      <a href="#order-form" class="px-8 py-4 rounded-2xl bg-emerald-400 text-slate-950 font-extrabold text-sm shadow-xl transition-all duration-300 hover:scale-105 hover:bg-emerald-300 text-center">
        Form Pesanan {namaLokasi}
      </a>
      <a href="#katalog" class="px-8 py-4 rounded-2xl bg-white/10 border border-white/25 text-white font-bold text-sm backdrop-blur-md transition-all duration-300 hover:scale-105 hover:bg-white/20 text-center">
        Lihat Katalog ({products.length})
      </a>
    </div>
  </div>
</section>

<!-- HIGHLIGHT INFO BAR -->
<section class="py-6 md:py-8 bg-emerald-900 text-white border-y border-emerald-800 shadow-inner">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 text-center">
