export async function getStaticPaths() {
  return kotaData.map((item) => ({
    params: { id: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const namaLokasi = item.lokasi.charAt(0).toUpperCase() + item.lokasi.slice(1);

function getHash(str: string) {
  let hash = 0;
  for (let i = 0; i < str.length; i++) {
    hash = str.charCodeAt(i) + ((hash << 5) - hash);
  }
  return Math.abs(hash);
}
const hash = getHash(item.id);
// Mengambil 4 kota berikutnya secara berurutan & berputar sesuai urutan JSON
const currentIndex = kotaData.findIndex((k) => k.id === item.id);
const kotaLain = [
  kotaData[(currentIndex + 1) % kotaData.length],
  kotaData[(currentIndex + 2) % kotaData.length],
  kotaData[(currentIndex + 3) % kotaData.length],
  kotaData[(currentIndex + 4) % kotaData.length],
