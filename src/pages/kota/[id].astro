              <button
                type="button"
                data-product-name={item.name}
                class="add-to-form-btn mt-4 w-full py-2.5 rounded-xl bg-emerald-50 text-emerald-700 font-extrabold text-xs text-center transition-all duration-300 hover:bg-emerald-600 hover:text-white active:scale-95 flex items-center justify-center gap-1.5 shadow-sm"
