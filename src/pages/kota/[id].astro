      <!-- Item 4: Quality Control -->
      <div class="p-4 bg-white/5 rounded-2xl border border-white/10 transition-all duration-300 hover:scale-105">
        <div class="text-emerald-300 font-extrabold text-base md:text-xl">QC Grade A</div>
        <div class="text-[10px] md:text-xs text-emerald-100/70 uppercase tracking-wider mt-1 font-medium">Sortir Tangan Pertama</div>
