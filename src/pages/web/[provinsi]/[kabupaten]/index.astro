    priceNormal: "Rp 4.500.000",
    pricePromo: "Rp 3.150.000",
    diskon: "Diskon 30%",
    periode: "PER TAHUN",
    popular: true,
    badge: "Terpopuler",
    features: [
      "Hosting 1 Tahun",
      "Gratis Domain",
      "Gratis Sertifikat SSL",
      "2x Revisi Design",
      "12x Update",
      "SEO & Mobile Friendly",
      "Prioritas Support Maintenance",
      "Setup 5 Halaman",
      "Input 10 Produk Awal",
      "Slider Banner",
      "Keranjang Belanja",
      "Fitur Cek Ongkir",
      "Integrasi WhatsApp",
      "Integrasi Marketplace",
    ]
  },
  {
    name: "Custom",
    target: "Solusi Skala Besar & Kebutuhan Khusus",
    priceNormal: "",
    pricePromo: "Sesuai Kebutuhan",
    diskon: "Custom Budget",
    periode: "PER TAHUN",
    popular: false,
    badge: "Fleksibel",
    features: [
      "Hosting Custom",
      "Bisa Pilih Domain",
      "Gratis Sertifikat SSL",
      "3x Revisi Design",
      "12x Update",
      "SEO & Mobile Friendly",
      "Dedicated Support",
      "Halaman Sesuai Kebutuhan",
      "Integrasi Sesuai Kebutuhan",
      "Design Custom",
      "Akses Penuh",
      "Dan lain-lain",
    ]
  }
];

// ============================================================
// 4. LAYANAN
// ============================================================
const services = [
  { icon: "🚀", title: "Landing Page", desc: "Halaman fokus konversi untuk campaign & produk." },
  { icon: "🏢", title: "Company Profile", desc: "Profil perusahaan kredibel & profesional." },
  { icon: "🛒", title: "E-Commerce", desc: "Toko online siap jualan dengan payment gateway." },
  { icon: "⚙️", title: "Web App & CMS", desc: "Aplikasi web custom sesuai alur bisnis." },
  { icon: "🎨", title: "Redesign Website", desc: "Ubah website lama jadi modern & cepat." },
  { icon: "🔧", title: "Maintenance", desc: "Update konten & perawatan website berkala." },
];

// ============================================================
// 5. PROSES
// ============================================================
const steps = [
  { no: "01", title: "Konsultasi", desc: "Diskusi kebutuhan & tujuan bisnis Anda." },
  { no: "02", title: "Desain", desc: "Wireframe & mockup sesuai brand Anda." },
  { no: "03", title: "Development", desc: "Coding rapi, cepat, dan SEO-friendly." },
  { no: "04", title: "Launch", desc: "Testing, deploy, dan monitoring." },
];

// ============================================================
// 6. SEO & SCHEMA MARKUP
// ============================================================
const siteUrl = "https://greenfresh.co.id"; // Sesuaikan dengan domain utama Anda
const currentUrl = `${siteUrl}/web/${provinsi}/${kabupaten}/`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
    { "@type": "ListItem", position: 2, name: provData.name, item: `${siteUrl}/web/${provinsi}` },
    { "@type": "ListItem", position: 3, name: kabData.name, item: currentUrl },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: content.faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": `Akbarweb - ${keywordKabupaten}`,
  "image": heroImg,
  "@id": currentUrl,
  "url": currentUrl,
  "telephone": "+6285938573419",
  "priceRange": "Rp999.000 - Rp3.150.000",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": kabData.name,
    "addressRegion": provData.name,
    "addressCountry": "ID"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": -6.2088,
    "longitude": 106.8456
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday",
      "Saturday",
      "Sunday"
    ],
    "opens": "08:00",
    "closes": "21:00"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "50",
    "bestRating": "5",
    "worstRating": "1"
  },
  "review": {
    "@type": "Review",
    "author": {
      "@type": "Person",
      "name": content.testimonial.name
    },
    "reviewRating": {
      "@type": "Rating",
      "ratingValue": "5",
      "bestRating": "5"
    },
    "reviewBody": content.testimonial.text
  }
};

const waNumber = "6285938573419";
const waLink = (msg: string) => `https://wa.me/${waNumber}?text=${encodeURIComponent(msg)}`;
---

<Layout
  title={`${keywordKabupaten} | akbarweb.com`}
  description={`Butuh ${keywordKabupaten}? Kami melayani pembuatan website bisnis, toko online, dan company profile profesional untuk seluruh wilayah di ${kabData.name}, ${provData.name}.`}
>
  <Fragment slot="head">
    <!-- Canonical Tag -->
    <link rel="canonical" href={currentUrl} />

    <meta name="keywords" content={`jasa pembuatan website ${kabData.name}, jasa buat web ${kabData.name}, bikin website murah ${kabData.name}, company profile ${kabData.name}, toko online ${kabData.name}, akbarweb`} />
    
    <!-- Schema Markups -->
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  </Fragment>

  <!-- ============================================================
       STYLE ANIMASI SCROLL REVEAL & STICKY FIX
       ============================================================ -->
  <style is:global>
    @keyframes floatSlow {
      0%, 100% { transform: translateY(0px) rotate(0deg); }
      50% { transform: translateY(-8px) rotate(0.5deg); }
    }
    @keyframes pulseGlow {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.85; transform: scale(1.03); }
    }

    .reveal-on-scroll {
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
      will-change: opacity, transform;
    }

    .reveal-on-scroll.active {
      opacity: 1;
      transform: translateY(0);
    }

    .anim-float {
      animation: floatSlow 5s ease-in-out infinite;
    }
    .anim-pulse-glow {
      animation: pulseGlow 3s ease-in-out infinite;
    }
    .anim-card-hover {
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .anim-card-hover:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 25px -8px rgba(0, 0, 0, 0.1);
    }

    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    /* Menggunakan overflow-x clip agar position sticky header tetap berfungsi */
    html {
      overflow-x: hidden;
    }
    body {
      overflow-x: clip;
    }

    @media (prefers-reduced-motion: reduce) {
      .reveal-on-scroll {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
      .anim-float, .anim-pulse-glow, .anim-card-hover {
        animation: none !important;
        transform: none !important;
        transition: none !important;
      }
    }
  </style>

  <div class="bg-white text-gray-800 w-full">

    <!-- ============ 1. HERO SECTION ============ -->
    <section class="bg-booking-700 text-white relative overflow-hidden">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-16 md:py-24 grid md:grid-cols-2 gap-8 items-center">

        <!-- Kiri: Teks -->
        <div class="reveal-on-scroll w-full">
          <nav aria-label="Breadcrumb" class="mb-3 sm:mb-5">
            <ol class="flex items-center flex-wrap gap-1 text-[11px] sm:text-xs text-white/80 leading-normal">
              <li><a href="/web" class="hover:text-yellow-400 transition">Home</a></li>
              <li><span class="mx-1">/</span></li>
              <li><a href={`/web/${provinsi}`} class="hover:text-yellow-400 transition">{provData.name}</a></li>
              <li><span class="mx-1">/</span></li>
              <li><span class="text-white font-medium truncate max-w-[140px] sm:max-w-none inline-block align-bottom" aria-current="page">{kabData.name}</span></li>
            </ol>
          </nav>

          <span class="inline-block text-[10px] sm:text-xs font-semibold uppercase tracking-wider bg-yellow-500 text-booking-700 px-3 py-1 rounded-full shadow-md anim-pulse-glow">
            ✨ Jangkauan Layanan {kabData.name}
          </span>

          <h1 class="text-2xl sm:text-3xl md:text-5xl font-extrabold mt-3 mb-3 sm:mb-4 leading-tight tracking-tight">
            {content.headline}
          </h1>
          <p class="text-xs sm:text-sm md:text-base text-white/90 leading-relaxed max-w-xl mb-6">
            {content.subheadline}
          </p>

          <div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto">
            <a href={waLink(`Halo akbarweb, saya tertarik konsultasi pembuatan website untuk bisnis saya di wilayah ${kabData.name}.`)}
               target="_blank" rel="noopener noreferrer"
               class="bk-btn-yellow px-5 py-3 text-xs sm:text-sm font-bold text-center shadow-lg active:scale-95 transition-all">
              💬 Konsultasi via WhatsApp
            </a>
            <a href="#harga"
               class="px-5 py-3 rounded-xl bg-white/10 border border-white/30 text-white font-semibold hover:bg-white/20 active:scale-95 transition-all text-xs sm:text-sm text-center">
              Lihat Paket Harga
            </a>
          </div>
        </div>

        <!-- Kanan: Gambar dengan Animasi Melayang -->
        <div class="relative reveal-on-scroll anim-float w-full max-w-md mx-auto md:max-w-none">
          <div class="relative rounded-2xl bg-white p-2 shadow-2xl">
            <div class="rounded-xl overflow-hidden bg-gray-50">
              <div class="flex items-center gap-2 px-3 py-2 bg-white border-b border-gray-200">
                <span class="w-2.5 h-2.5 rounded-full bg-red-400"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-yellow-400"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-green-400"></span>
                <span class="ml-2 text-[10px] sm:text-xs text-gray-400 font-mono truncate">akbarweb.com/web/{provinsi}/{kabupaten}</span>
              </div>
              <img
                src={heroImg}
                alt={`Foto tim bisnis profesional di ${kabData.name} — akbarweb.com`}
                class="w-full h-48 sm:h-64 md:h-80 object-cover"
                loading="eager"
                width="600"
                height="400"
              />
            </div>
          </div>

          <div class="absolute -top-2 -right-2 sm:-top-3 sm:-right-3 bg-yellow-500 text-booking-700 rounded-lg px-2.5 py-1 text-[11px] sm:text-xs font-bold shadow-lg animate-bounce">
            ⚡ PageSpeed 100
          </div>
          <div class="absolute -bottom-2 -left-2 sm:-bottom-3 sm:-left-3 bg-white border border-gray-200 rounded-lg px-2.5 py-1 text-[11px] sm:text-xs font-bold text-booking-700 shadow-lg">
            📈 +40% Conversion
          </div>
        </div>

      </div>
    </section>

    <!-- ============ 2. STATS BAR ============ -->
    <section class="bg-yellow-500 shadow-inner">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-5 sm:py-6 grid grid-cols-2 md:grid-cols-4 gap-4">
        {content.stats.map((s) => (
          <div class="text-center text-booking-700 reveal-on-scroll">
            <p class="text-xl sm:text-2xl md:text-4xl font-black">{s.value}</p>
            <p class="text-[11px] sm:text-xs md:text-sm font-semibold opacity-90">{s.label}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ============ 3. LAYANAN ============ -->
    <section class="bg-booking-700 text-white border-y border-white/10 py-10 sm:py-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-8 sm:mb-12 reveal-on-scroll">
          <span class="inline-block text-[11px] sm:text-xs font-bold uppercase tracking-wider bg-yellow-500 text-booking-700 px-3 py-1 rounded-full">
            Layanan Kami
          </span>
          <h2 class="text-xl sm:text-2xl md:text-4xl font-bold mt-2 sm:mt-3">
            Apa yang Bisa <span class="bk-highlight">Kami Bantu</span> di {kabData.name}?
          </h2>
          <p class="mt-2 text-xs sm:text-sm text-white/80 max-w-xl mx-auto">
            Solusi website lengkap untuk mendukung transformasi digital bisnis Anda.
          </p>
        </div>

        <div class="grid gap-4 sm:gap-6 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
          {services.map((s) => (
            <div class="group rounded-xl p-5 sm:p-6 flex flex-col bg-white/5 border border-white/15 backdrop-blur anim-card-hover reveal-on-scroll">
              <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-yellow-500 text-booking-700 grid place-items-center text-lg sm:text-xl mb-3 sm:mb-4 group-hover:scale-110 transition-transform shadow-md">
                {s.icon}
              </div>
              <h3 class="font-bold text-base sm:text-lg mb-1 sm:mb-2 text-white">{s.title}</h3>
              <p class="text-xs sm:text-sm text-white/80 leading-relaxed flex-1">
                {s.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ 4. INDUSTRI UNGGULAN ============ -->
    <section class="bg-gray-50 border-y border-gray-200 py-10 sm:py-14">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 text-center">
        <div class="mb-6 sm:mb-8 reveal-on-scroll">
          <span class="text-[11px] sm:text-xs font-bold uppercase tracking-wider text-booking-600 bg-booking-100 px-3 py-1 rounded-full">Fokus Kami</span>
          <h2 class="text-xl sm:text-2xl md:text-3xl font-bold text-gray-900 mt-2">Sektor Bisnis di {kabData.name}</h2>
          <p class="mt-1 text-xs sm:text-sm text-gray-600 max-w-lg mx-auto">Sistem web yang dirancang sesuai dengan ekosistem bisnis dan kebutuhan pasar daerah Anda.</p>
        </div>
        <div class="flex flex-wrap justify-center gap-2 sm:gap-3">
          {content.highlightIndustry.map((ind) => (
            <div class="bg-white border border-gray-200 px-4 py-2 sm:px-5 sm:py-3 rounded-xl shadow-sm hover:border-booking-500 hover:shadow-md transition-all reveal-on-scroll">
              <span class="text-xs sm:text-sm font-bold text-booking-700">{ind}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ 5. PAKET HARGA TERBARU ============ -->
    <section id="harga" class="bg-gray-100 border-y border-gray-200 py-10 sm:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-10 sm:mb-12 reveal-on-scroll">
          <span class="inline-block text-[11px] sm:text-xs font-bold uppercase tracking-wider bg-booking-100 text-booking-700 px-3 py-1 rounded-full shadow-sm">
            Paket Harga
          </span>
          <h2 class="text-xl sm:text-2xl md:text-4xl font-bold text-gray-900 mt-2 sm:mt-3">
            Pilihan Paket <span class="text-booking-700">Terbaik di {kabData.name}</span>
          </h2>
          <p class="mt-2 text-xs sm:text-sm md:text-base text-gray-600 max-w-xl mx-auto">
            Investasi website profesional dengan harga transparan, fitur lengkap, dan tanpa biaya tersembunyi.
          </p>
        </div>

        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4 items-stretch">
          {pricing.map((p) => (
            <div class:list={[
              "rounded-2xl bg-white border shadow-xl flex flex-col justify-between anim-card-hover reveal-on-scroll",
              p.popular ? "border-2 border-yellow-500 lg:-translate-y-2 ring-4 ring-yellow-500/20" : "border-gray-200"
            ]}>
              <div>
                <div class="bg-booking-700 text-white p-5 sm:p-6 text-center relative rounded-t-2xl">
                  {p.badge ? (
                    <div class="mb-2 sm:mb-3 flex justify-center">
                      <span class="px-2.5 py-0.5 rounded-full bg-yellow-400 text-booking-700 text-[10px] sm:text-xs font-extrabold shadow-md animate-bounce whitespace-nowrap">
                        ⭐ {p.badge.toUpperCase()}
                      </span>
                    </div>
                  ) : (
                    <div class="mb-2 sm:mb-3 h-5 sm:h-6"></div>
                  )}

                  <h3 class="text-lg sm:text-xl font-bold text-white mb-1">{p.name}</h3>
                  <p class="text-[11px] sm:text-xs text-white/80 mb-3 sm:mb-4 h-7 sm:h-8 flex items-center justify-center px-2">{p.target}</p>

                  <div class="bg-black/20 p-2.5 sm:p-3 rounded-xl border border-white/10">
                    {p.priceNormal && (
