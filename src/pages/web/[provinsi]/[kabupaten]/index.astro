---
import Layout from "../../../../layouts/Layouts.astro";
import wilayahData from "../../../../data/wilayah_indonesia.json";

// ============================================================
// 1. GET STATIC PATHS (DINAMIS UNTUK PROVINSI & KABUPATEN)
// ============================================================
export function getStaticPaths() {
  let paths: any[] = [];
  
  wilayahData.forEach((prov: any) => {
    if (prov.regencies && Array.isArray(prov.regencies)) {
      prov.regencies.forEach((kab: any) => {
        paths.push({
          params: { 
            provinsi: prov.slug, 
            kabupaten: kab.slug 
          },
          props: { 
            provData: prov, 
            kabData: kab 
          },
        });
      });
    }
  });

  return paths;
}

// ============================================================
// 2. DATA & KONTEN PROGRAMMATIC SEO
// ============================================================
const { provinsi, kabupaten } = Astro.params;
const { provData, kabData } = Astro.props;

const keywordKabupaten = `Jasa buat web di ${kabData.name}`;

const content = {
  headline: `Jasa Buat Web di ${kabData.name} — Website Profesional untuk Bisnis Anda`,
  subheadline: `Tingkatkan omzet dan kredibilitas bisnis Anda di ${kabData.name}, ${provData.name} dengan website profesional, cepat, dan siap tampil di halaman pertama Google.`,
  highlightIndustry: ["UMKM & Retail", "Kuliner & F&B", "Jasa Konsultan", "Properti & Developer", "Pariwisata & Travel", "Agribisnis"],
  whyUs: [
    { icon: "⚡", title: `Paham Karakter ${kabData.name}`, desc: `Kami mengerti kebutuhan dan persaingan pasar lokal di ${kabData.name} untuk strategi digital yang tepat.` },
    { icon: "📱", title: "Cepat & Mobile-First", desc: "Website dioptimasi khusus agar mulus diakses dari HP, mendatangkan lebih banyak konversi." },
    { icon: "🔍", title: `SEO Lokal ${kabData.name}`, desc: `Struktur web dirancang agar bisnis Anda mudah ditemukan pelanggan sekitar ${kabData.name}.` },
    { icon: "💬", title: "Support WhatsApp", desc: "Tim support kami siap membantu kapan pun Anda membutuhkan bantuan teknis via WhatsApp." },
  ],
  faqs: [
    { q: `Berapa lama proses pembuatan website untuk bisnis di ${kabData.name}?`, a: "Waktu pengerjaan standar adalah 3–5 hari kerja untuk Paket Gold, dan 7–10 hari untuk Paket Platinum/E-Commerce tergantung kelengkapan data." },
    { q: "Apakah sudah termasuk domain dan hosting?", a: "Ya! Semua paket kami sudah termasuk gratis domain (.com / .id) selama 1 tahun dan cloud hosting performa tinggi." },
    { q: "Apakah website mudah di-update sendiri?", a: "Sangat mudah. Anda akan mendapatkan akses ke halaman admin yang user-friendly beserta panduan cara menggunakannya." },
    { q: `Bisakah website ini diakses pelanggan dari luar ${kabData.name}?`, a: "Tentu saja. Website Anda akan online 24 jam penuh dan bisa diakses oleh siapa saja dari seluruh Indonesia bahkan dunia." },
    { q: "Bagaimana cara melakukan pembayaran?", a: "Pembayaran dapat dilakukan melalui transfer bank yang akan kami infokan melalui WhatsApp setelah kesepakatan project." },
    { q: "Apakah ada biaya bulanan?", a: "Tidak ada biaya bulanan. Anda hanya perlu memperpanjang domain dan hosting setahun sekali." },
  ],
  testimonial: { 
    name: "Klien akbarweb", 
    role: "Pemilik Usaha", 
    company: `Bisnis Lokal di ${kabData.name}`, 
    text: `Sejak dibuatkan website oleh akbarweb, pelanggan dari luar daerah pun mulai berdatangan. Loadingnya cepat dan sangat mudah digunakan. Terima kasih tim akbarweb!` 
  },
  stats: [
    { value: "50+", label: `Website Lokal ${kabData.name}` },
    { value: "4.9/5", label: "Rating Klien" },
    { value: "7 Hari", label: "Rata-rata Delivery" },
    { value: "99.9%", label: "Uptime" },
  ],
};

const heroImg = "https://images.unsplash.com/photo-1497366216548-37526070297c?q=80&w=1000&auto=format&fit=crop";

// ============================================================
// 3. PAKET HARGA TERBARU (GOLD, PLATINUM, DIAMOND, CUSTOM)
// ============================================================
const pricing = [
  {
    name: "Gold",
    target: "Paket Website Landing Page / UMKM",
    priceNormal: "Rp 2.500.000",
    pricePromo: "Rp 999.000",
    diskon: "Diskon 60%",
    periode: "PER TAHUN",
    popular: false,
    badge: null,
    features: [
