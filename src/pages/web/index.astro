---
import Layout from "../../layouts/Layouts.astro";
import wilayahData from "../../data/wilayah_indonesia.json";

const waNumber = "6285938573419";
const waLink = (msg: string) => `https://wa.me/${waNumber}?text=${encodeURIComponent(msg)}`;

const heroStats = [
  { value: "150+", label: "Sites Delivered" },
