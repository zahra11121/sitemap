const steps = [
  { no: "01", title: "Discovery & Strategy", desc: "Riset bisnis, target audiens, dan tujuan konversi." },
  { no: "02", title: "UI/UX Design", desc: "Wireframe hingga prototype interaktif di Figma." },
  { no: "03", title: "Development & SEO", desc: "Coding rapi, cepat, dan SEO on-page built-in." },
  { no: "04", title: "Testing & Launch", desc: "QA lintas device, deploy, dan monitoring." },
];

const pricing = [
  {
    name: "Gold",
    target: "Paket Website Landing Page / UMKM",
    priceNormal: "Rp 2.500.000",
    pricePromo: "Rp 999.000",
    diskon: "Diskon 60%",
    periode: "PER TAHUN",
    popular: false,
