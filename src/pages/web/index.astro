const testimonials = [
  { name: "Budi Santoso", role: "Owner", company: "Kopi Nusantara", text: "Website cepat dan rapi. Penjualan online naik 40% dalam 2 bulan.", initial: "BS" },
  { name: "Rina Wijaya", role: "Direktur", company: "Klinik Sehat", text: "Tim responsif dan paham kebutuhan bisnis. Hasilnya profesional.", initial: "RW" },
  { name: "Andi Pratama", role: "Founder", company: "Kursus Coding", text: "Desain modern dan mudah diupdate. Sangat worth it.", initial: "AP" },
];

const faqs = [
  { 
    q: "Berapa lama proses pengerjaan pembuatan website?", 
    a: "Paket Gold selesai dalam 3–5 hari kerja, Platinum 7–10 hari, sedangkan Diamond atau Custom memakan waktu 2–3 minggu tergantung tingkat kompleksitas fitur." 
  },
  { 
    q: "Apakah sudah termasuk domain dan hosting?", 
    a: "Ya! Paket Gold, Platinum, dan Diamond sudah termasuk gratis domain (.com / .id) selama 1 tahun penuh beserta hosting performa tinggi." 
  },
  { 
    q: "Apakah saya bisa melakukan revisi selama proses pembuatan?", 
    a: "Tentu saja. Setiap paket sudah mencakup kuota revisi desain (minor hingga standar) agar hasil akhirnya sesuai dengan keinginan Anda." 
  },
  { 
    q: "Apakah website dijamin ramah SEO (Search Engine Optimization)?", 
    a: "Sangat ramah SEO. Setiap website dibangun dengan struktur kode semantik yang bersih, kecepatan muat super cepat, serta meta tags lengkap." 
  },
  { 
    q: "Bagaimana jika ada kendala atau butuh maintenance setelah website rilis?", 
    a: "Kami menyediakan layanan update berkala serta support maintenance sesuai dengan ketentuan paket yang Anda ambil." 
  },
  { 
    q: "Bagaimana sistem pembayarannya?", 
    a: "Pembayaran transparan melalui transfer atau sistem termin yang disepakati via WhatsApp sebelum pengerjaan dimulai." 
  },
];

const provinsiPopuler = wilayahData.slice(0, 12);

/* Schema Markup Diperbaiki untuk Deteksi Rich Results Google */
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": "https://greenfresh.co.id/web/#service",
      "name": "AkbarWeb Jasa Pembuatan Website",
      "description": "Jasa pembuatan website profesional di Indonesia. Landing page, company profile, e-commerce, dan web app.",
      "url": "https://greenfresh.co.id/web/",
      "telephone": "+6285938573419",
      "priceRange": "Rp 999.000 - Rp 3.150.000",
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "ID"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "5.0",
        "reviewCount": "100",
        "bestRating": "5",
        "worstRating": "1"
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://greenfresh.co.id/web/#faq",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.a
        }
      }))
    }
  ]
};
---

<Layout
  title="AkbarWeb | Jasa Pembuatan Website Profesional & Cepat"
  description="Jasa pembuatan website profesional di Indonesia. Landing page, company profile, e-commerce, dan web app. Cepat, SEO-friendly, dan fokus konversi. Konsultasi gratis via WhatsApp."
>
  <Fragment slot="head">
    <link rel="canonical" href="https://greenfresh.co.id/web/" />
    <meta name="keywords" content="jasa pembuatan website, jasa buat web, bikin website murah, jasa website company profile, jasa pembuatan toko online, e-commerce murah, landing page profesional, jasa SEO Indonesia, akbarweb" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="bg-white text-gray-800 overflow-hidden">

    <!-- ============ 1. HERO ============ -->
    <section class="relative bg-booking-700 reveal-bottom">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-16 md:py-24 grid md:grid-cols-2 gap-8 sm:gap-12 items-center">
        <div>
          <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-white/10 border border-white/20 text-[10px] sm:text-xs font-semibold text-white mb-4 sm:mb-6 animate-bounce">
            <span class="w-2 h-2 rounded-full bg-yellow-500 animate-ping"></span>
            🚀 Website Online dalam 48 Jam
          </span>

          <h1 class="text-2xl sm:text-3xl md:text-5xl font-bold tracking-tight text-white leading-[1.2]">
            <span class="bk-highlight">Jasa Pembuatan Website</span> Profesional untuk Bisnis Anda
          </h1>

          <p class="mt-3 sm:mt-5 text-sm sm:text-base md:text-lg text-white/90 max-w-lg leading-relaxed">
            Website cepat, SEO-friendly, dan fokus konversi.
            Dibangun dengan tech stack modern — siap tingkatkan penjualan Anda.
          </p>

          <div class="mt-5 sm:mt-8 flex flex-col sm:flex-row gap-2 sm:gap-3">
            <a href={waLink("Halo akbarweb, saya tertarik konsultasi pembuatan website.")} target="_blank" rel="noopener noreferrer"
               class="bk-btn-yellow px-6 sm:px-8 py-2.5 sm:py-3 text-sm sm:text-base text-center shadow-lg transition-all">
              Buatkan Saya Website
            </a>
            <a href="#harga" class="px-6 sm:px-8 py-2.5 sm:py-3 rounded-md bg-white/10 border border-white/30 text-white font-semibold hover:bg-white/20 hover:border-yellow-400 transition-all text-sm sm:text-base text-center">
              Lihat Paket Harga
            </a>
          </div>

          <div class="mt-5 sm:mt-8 flex items-center gap-3 sm:gap-4">
            <div class="flex -space-x-2">
              {["BS", "RW", "AP", "DN"].map((i) => (
                <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-yellow-500 border-2 border-booking-700 grid place-items-center text-[10px] sm:text-xs font-bold text-booking-700 shadow-sm">
                  {i}
                </div>
              ))}
            </div>
            <div>
              <div class="text-yellow-400 text-xs sm:text-sm">★★★★★</div>
              <p class="text-[10px] sm:text-xs text-white/80">Dipercaya 100+ bisnis</p>
            </div>
          </div>
        </div>

        <div class="relative">
          <div class="relative rounded-lg bg-white p-1.5 sm:p-2 shadow-2xl hover:scale-105 transition-transform duration-300">
            <div class="rounded overflow-hidden bg-gray-50">
              <div class="flex items-center gap-1.5 sm:gap-2 px-3 sm:px-4 py-2 sm:py-2.5 bg-white border-b border-gray-200">
                <span class="w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-full bg-red-400"></span>
                <span class="w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-full bg-yellow-400"></span>
                <span class="w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-full bg-green-400"></span>
                <span class="ml-2 sm:ml-3 text-[10px] sm:text-xs text-gray-400 font-mono">akbarweb.com</span>
              </div>
              <img
                src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?q=80&w=1000&auto=format&fit=crop"
                alt="Dashboard analitik website modern untuk bisnis"
                class="w-full h-auto object-cover"
                loading="eager"
                width="600"
                height="400"
              />
            </div>
          </div>
          <div class="absolute -top-2 sm:-top-3 -right-2 sm:-right-3 bg-yellow-500 text-booking-700 rounded-md px-2 sm:px-3 py-1 sm:py-1.5 text-[10px] sm:text-xs font-bold shadow-lg animate-bounce">
            ⚡ PageSpeed 100
          </div>
          <div class="absolute -bottom-2 sm:-bottom-3 -left-2 sm:-left-3 bg-white border border-gray-200 rounded-md px-2 sm:px-3 py-1 sm:py-1.5 text-[10px] sm:text-xs font-bold text-booking-700 shadow-lg">
            📈 +40% Conversion
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 2. PARTNER ============ -->
    <section class="bg-gray-50 border-b border-gray-200 reveal-left">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-10">
        <p class="text-center text-[10px] sm:text-xs text-gray-500 uppercase tracking-widest mb-3 sm:mb-6 font-semibold">Tech Stack & Partners</p>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-3 md:gap-4">
          {logos.map((logo) => (
            <div class="flex items-center justify-center px-3 sm:px-4 py-2.5 sm:py-3 bg-booking-700 border border-booking-700 rounded-md hover:bg-booking-800 hover:border-yellow-500 hover:-translate-y-2 transition-all shadow-sm">
              <span class="text-white font-bold text-sm sm:text-base md:text-lg whitespace-nowrap">
                {logo}
              </span>
            </div>
          ))}
        </div>

        <div class="grid grid-cols-3 gap-2 sm:gap-4 mt-5 sm:mt-8 pt-5 sm:pt-8 border-t border-gray-200">
          {heroStats.map((s) => (
            <div class="text-center group">
              <p class="text-xl sm:text-2xl md:text-3xl font-bold text-booking-700">{s.value}</p>
              <p class="text-[10px] sm:text-xs text-gray-500 mt-0.5 sm:mt-1">{s.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ 3. PROBLEM vs SOLUTION ============ -->
    <section class="bg-white reveal-right">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-16">
        <div class="text-center mb-6 sm:mb-10">
          <h2 class="text-xl sm:text-2xl md:text-4xl font-bold text-gray-900">Website Anda Bermasalah?</h2>
          <p class="mt-1 sm:mt-2 text-sm sm:text-base text-gray-600">Bandingkan kondisi website lama vs modern.</p>
        </div>
        <div class="grid md:grid-cols-2 gap-3 sm:gap-4">
          <div class="bk-card p-4 sm:p-6 border-l-4 border-l-red-500">
            <div class="flex items-center gap-2 sm:gap-3 mb-3 sm:mb-4">
              <span class="w-8 h-8 sm:w-10 sm:h-10 rounded-md bg-red-100 grid place-items-center text-red-600 text-base sm:text-xl font-bold">✕</span>
              <h3 class="text-base sm:text-lg font-bold text-gray-900">Website Lama</h3>
            </div>
            <ul class="space-y-2 sm:space-y-2.5">
              {problems.map((p) => (
                <li class="flex items-start gap-2 text-xs sm:text-sm text-gray-700">
                  <span class="text-red-500 mt-0.5 font-bold">✕</span>
                  {p}
                </li>
              ))}
            </ul>
          </div>
          <div class="bk-card p-4 sm:p-6 border-l-4 border-l-booking-700 relative">
            <div class="absolute top-3 sm:top-4 right-3 sm:right-4 px-1.5 sm:px-2 py-0.5 sm:py-1 rounded bg-yellow-500 text-booking-700 text-[10px] sm:text-xs font-bold animate-bounce">RECOMMENDED</div>
            <div class="flex items-center gap-2 sm:gap-3 mb-3 sm:mb-4">
              <span class="w-8 h-8 sm:w-10 sm:h-10 rounded-md bg-booking-100 grid place-items-center text-booking-700 text-base sm:text-xl font-bold">✓</span>
              <h3 class="text-base sm:text-lg font-bold text-gray-900">AkbarWeb Solution</h3>
            </div>
            <ul class="space-y-2 sm:space-y-2.5">
              {solutions.map((s) => (
                <li class="flex items-start gap-2 text-xs sm:text-sm text-gray-700">
                  <span class="text-booking-700 mt-0.5 font-bold">✓</span>
                  {s}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 4. SERVICES ============ -->
    <section id="layanan" class="bg-booking-700 text-white border-y border-white/10 reveal-bottom">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-16">
        <div class="text-center mb-6 sm:mb-10">
          <span class="inline-block text-[10px] sm:text-xs font-bold uppercase tracking-wider bg-yellow-500 text-booking-700 px-2.5 py-1 rounded">
            Layanan Kami
          </span>
          <h2 class="text-xl sm:text-2xl md:text-4xl font-bold mt-2 sm:mt-3">
            Apa yang Bisa <span class="bk-highlight">Kami Bantu</span>?
          </h2>
          <p class="mt-1 sm:mt-2 text-sm sm:text-base text-white/80">
            Solusi website sesuai kebutuhan bisnis Anda — dari landing page sampai web app custom.
          </p>
        </div>

        <div class="grid gap-3 sm:gap-4 grid-cols-2 lg:grid-cols-4">
          {services.map((s) => (
            <div class="group rounded-md p-3 sm:p-6 flex flex-col bg-white/5 border border-white/15 backdrop-blur hover:bg-white/10 hover:border-yellow-400 hover:-translate-y-2 transition-all duration-300">
              <div class="w-9 h-9 sm:w-12 sm:h-12 rounded-md bg-yellow-500 text-booking-700 grid place-items-center text-lg sm:text-2xl mb-2 sm:mb-4 group-hover:scale-110 transition-transform">
                {s.icon}
              </div>
              <h3 class="font-bold mb-1 sm:mb-2 text-xs sm:text-base text-white">{s.title}</h3>
              <p class="text-[10px] sm:text-sm text-white/80 mb-2 sm:mb-4 leading-relaxed flex-1 line-clamp-2 sm:line-clamp-none">
                {s.desc}
              </p>
              <ul class="space-y-1 sm:space-y-1.5 mb-3 sm:mb-5 hidden sm:block">
                {s.features.map((f) => (
                  <li class="text-[10px] sm:text-xs text-white/80 flex items-center gap-1.5 sm:gap-2">
                    <span class="text-yellow-400">✓</span> {f}
                  </li>
                ))}
              </ul>
              <a href={waLink(`Halo akbarweb, saya tertarik dengan layanan ${s.title}.`)}
                 target="_blank" rel="noopener noreferrer"
                 class="text-[10px] sm:text-sm text-yellow-400 font-bold hover:text-yellow-300 inline-flex items-center gap-1 group/link">
                Detail
                <span class="group-hover/link:translate-x-1 transition-transform">→</span>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ 5. WORKFLOW ============ -->
    <section class="bg-gray-50 border-y border-gray-200 reveal-left">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-16">
        <div class="text-center mb-6 sm:mb-10">
          <h2 class="text-xl sm:text-2xl md:text-4xl font-bold text-gray-900">Proses Kerja Kami</h2>
          <p class="mt-1 sm:mt-2 text-sm sm:text-base text-gray-600">Transparan, terstruktur, dan tepat waktu.</p>
        </div>
        <div class="relative grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
          <div class="hidden md:block absolute top-8 left-[12%] right-[12%] h-0.5 bg-gray-300"></div>
          {steps.map((s) => (
            <div class="relative text-center group">
              <div class="relative z-10 w-12 h-12 sm:w-16 sm:h-16 mx-auto rounded-md bg-booking-700 grid place-items-center text-white font-bold text-sm sm:text-lg mb-2 sm:mb-4 group-hover:bg-yellow-500 group-hover:text-booking-700 transition-all shadow-md">
                {s.no}
              </div>
              <h3 class="font-bold text-gray-900 mb-1 sm:mb-2 text-xs sm:text-base">{s.title}</h3>
              <p class="text-[10px] sm:text-sm text-gray-600 leading-relaxed">{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ 6. PRICING ============ -->
    <section id="harga" class="bg-gray-100 border-y border-gray-200 py-12 sm:py-20 reveal-right">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-10 sm:mb-14">
          <span class="inline-block text-[10px] sm:text-xs font-bold uppercase tracking-wider bg-booking-100 text-booking-700 px-3 py-1 rounded-full shadow-sm">
            Paket Harga
          </span>
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 mt-2 sm:mt-3">
            Pilihan Paket <span class="text-booking-700">Terbaik Untuk Anda</span>
          </h2>
          <p class="mt-2 text-sm sm:text-base text-gray-600">
            Investasi website profesional dengan harga transparan dan fitur lengkap.
          </p>
        </div>

        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4 items-stretch pt-4">
          {pricing.map((p) => (
            <div class:list={[
              "rounded-2xl bg-white border shadow-xl flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 relative",
              p.popular ? "border-2 border-yellow-500 lg:-translate-y-2 ring-4 ring-yellow-500/20" : "border-gray-200"
            ]}>
              <div>
                <div class="bg-booking-700 text-white p-6 text-center relative rounded-t-2xl">
                  {p.badge ? (
                    <div class="mb-3 flex justify-center">
                      <span class="px-3 py-1 rounded-full bg-yellow-400 text-booking-700 text-xs font-extrabold shadow-md animate-bounce whitespace-nowrap">
                        ⭐ {p.badge.toUpperCase()}
                      </span>
                    </div>
                  ) : (
                    <div class="mb-3 h-6"></div>
                  )}

                  <h3 class="text-xl font-bold text-white mb-1">{p.name}</h3>
                  <p class="text-xs text-white/80 mb-4 h-8 flex items-center justify-center">{p.target}</p>

                  <div class="bg-black/20 p-3 rounded-xl border border-white/10">
                    {p.priceNormal && (
                      <span class="text-xs text-red-300 line-through block font-mono">{p.priceNormal}</span>
                    )}
                    <span class="text-2xl sm:text-3xl font-extrabold text-yellow-400">{p.pricePromo}</span>
                    <div class="mt-1 flex items-center justify-center gap-1.5 flex-wrap">
                      <span class="text-[11px] bg-yellow-500/20 text-yellow-300 font-semibold px-2 py-0.5 rounded-full">
                        {p.diskon}
                      </span>
                      <span class="text-[10px] text-white/70 font-mono tracking-wider">{p.periode}</span>
                    </div>
