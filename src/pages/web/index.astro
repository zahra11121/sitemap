  { icon: "🏢", title: "Company Profile", desc: "Profil perusahaan kredibel yang membangun kepercayaan klien.", features: ["Multi-page", "Blog & CMS", "SEO optimized"] },
  { icon: "🛒", title: "E-Commerce", desc: "Toko online siap jualan dengan pembayaran & inventori.", features: ["Payment gateway", "Product management", "Order tracking"] },
  { icon: "⚙️", title: "Web App & CMS", desc: "Aplikasi web custom sesuai alur bisnis Anda.", features: ["Dashboard admin", "Role & auth", "API integration"] },
