---
// src/pages/blog/[id].astro
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getArticleBySlug, getRelatedArticles, articles, type Article } from '../../data/articles';

export async function getStaticPaths() {
  return articles.map((article) => ({
    params: { id: article.slug },
    props: { article },
  }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
const related = getRelatedArticles(article.slug, 3);

const siteUrl = 'https://greenfresh.co.id';
const pageUrl = `${siteUrl}/blog/${article.slug}`;
const pageTitle = `${article.title} — CV Green Fresh Cipanas`;
const pageDescription = article.excerpt;
const formattedDate = new Date(article.date).toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

// Pecah konten jadi paragraf
const paragraphs = article.content
  .trim()
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);

// Helper highlight kata kunci
const highlightKeywords = (html: string) => {
  const keywords = ['Grade A', 'Cipanas', 'Puncak', 'segar', 'chiller', 'B2B', 'TOP 7', 'FIFO'];
  let out = html;
  keywords.forEach((k) => {
    const re = new RegExp(`(?![^<]*>)(${k})`, 'gi');
    out = out.replace(re, '<mark class="kw-highlight">$1</mark>');
  });
  return out;
};

const wordCount = article.content.split(/\s+/).length;

const jsonLdSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'CV Green Fresh Cipanas',
      url: siteUrl,
    },
    {
      '@type': 'BlogPosting',
      '@id': `${pageUrl}/#article`,
      headline: article.title,
      description: article.excerpt,
      datePublished: article.date,
      dateModified: article.date,
      author: { '@type': 'Organization', name: article.author },
      publisher: { '@id': `${siteUrl}/#organization` },
      mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
      image: `${siteUrl}/og-image.jpg`,
      articleSection: article.category,
      inLanguage: 'id-ID',
      wordCount: wordCount,
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}/#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Beranda', item: siteUrl },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteUrl}/blog` },
        { '@type': 'ListItem', position: 3, name: article.title, item: pageUrl },
      ],
    },
  ],
};
---

<Layout title={pageTitle} description={pageDescription} canonical={pageUrl}>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="author" content={article.author} />
    <meta name="theme-color" content="#064e3b" />

    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="CV Green Fresh Cipanas" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:image" content={`${siteUrl}/og-image.jpg`} />
    <meta property="article:published_time" content={article.date} />
    <meta property="article:section" content={article.category} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={`${siteUrl}/og-image.jpg`} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLdSchema)} />
  </Fragment>

  <!-- BREADCRUMB -->
  <nav aria-label="Breadcrumb" class="bg-emerald-50/60 border-b border-emerald-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <ol class="flex flex-wrap items-center gap-1.5 text-[11px] md:text-xs text-slate-500 font-semibold">
        <li><a href="/" class="hover:text-emerald-700 transition-colors">Beranda</a></li>
        <li aria-hidden="true" class="text-slate-300">/</li>
        <li><a href="/blog" class="hover:text-emerald-700 transition-colors">Blog</a></li>
        <li aria-hidden="true" class="text-slate-300">/</li>
        <li class="text-emerald-700 line-clamp-1" aria-current="page">{article.title}</li>
      </ol>
    </div>
  </nav>

  <!-- HERO ARTIKEL -->
  <section class="relative bg-gradient-to-br from-emerald-950 via-emerald-900 to-slate-950 text-white overflow-hidden">
    <div class="absolute -top-40 -right-40 w-96 h-96 bg-emerald-500/20 rounded-full blur-3xl"></div>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 md:pt-16 pb-10 md:pb-14 relative z-10">
      <a href="/blog" class="inline-flex items-center gap-1.5 text-emerald-300 hover:text-emerald-200 text-xs font-bold mb-4 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Kembali ke Blog
      </a>

      <span class="inline-block px-3 py-1 rounded-full bg-emerald-500/20 border border-emerald-400/30 text-emerald-300 text-[10px] md:text-xs font-extrabold uppercase tracking-wider mb-3">
        {article.category}
      </span>

      <h1 class="text-2xl sm:text-4xl md:text-5xl font-extrabold tracking-tight leading-tight text-transparent bg-clip-text bg-gradient-to-r from-white via-emerald-100 to-teal-200">
        {article.title}
      </h1>

      <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs md:text-sm text-emerald-100/80 font-medium">
        <span class="inline-flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          {article.author}
        </span>
        <span class="inline-flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <time datetime={article.date}>{formattedDate}</time>
        </span>
        <span class="inline-flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          {article.readTime} menit baca
        </span>
      </div>
    </div>
  </section>

  <!-- GAMBAR UTAMA -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 -mt-6 md:-mt-10 relative z-20">
    <div class="rounded-3xl overflow-hidden border-4 border-white shadow-2xl aspect-[16/9] bg-slate-100">
      <Image
        src={article.image}
        alt={`${article.title} — CV Green Fresh Cipanas`}
        width={1200}
        height={675}
        class="w-full h-full object-cover"
        loading="eager"
        decoding="async"
        format="webp"
        quality={85}
      />
    </div>
  </div>

  <!-- KONTEN ARTIKEL -->
  <article class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-10">
      <!-- BODY -->
      <div class="min-w-0">
        <p class="text-base md:text-lg text-slate-700 leading-relaxed font-medium border-l-4 border-emerald-500 pl-4 italic mb-8">
          {article.excerpt}
        </p>

        <div class="article-body space-y-6 md:space-y-7 text-slate-700">
          {paragraphs.map((p, i) => (
            <p
              class:list={[
                'article-paragraph text-[15px] md:text-[17px] leading-[1.9] tracking-[0.01em]',
                i === 0 && 'first-paragraph',
                i % 2 === 1 && 'alt-paragraph',
              ]}
              set:html={highlightKeywords(p)}
            />
          ))}
        </div>

        <!-- CTA -->
        <div class="mt-10 p-5 md:p-6 rounded-2xl bg-emerald-50 border border-emerald-200">
          <h3 class="font-extrabold text-slate-900 text-sm md:text-base mb-1">
            Butuh pasokan {article.category.toLowerCase()} segar?
          </h3>
          <p class="text-xs md:text-sm text-slate-600 mb-4">
            CV Green Fresh Cipanas memasok sayur Grade A untuk hotel, restoran, katering, dan supermarket. Minimal order Rp 1.500.000, termin 7 hari.
          </p>
          <a
            href={`https://wa.me/6287780937884?text=${encodeURIComponent(`Halo Green Fresh, saya baca artikel "${article.title}" dan ingin konsultasi pasokan.`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-emerald-600 text-white font-extrabold text-xs md:text-sm hover:bg-emerald-700 active:scale-95 transition-all shadow-lg shadow-emerald-600/30"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z" />
            </svg>
            Konsultasi via WhatsApp
          </a>
        </div>
      </div>

      <!-- SIDEBAR -->
      <aside class="lg:sticky lg:top-24 self-start">
        <h3 class="font-extrabold text-slate-900 text-sm uppercase tracking-wider mb-3">Artikel Terkait</h3>
        <div class="space-y-3">
          {related.map((rel) => (
            <a
              href={`/blog/${rel.slug}`}
              class="group flex gap-3 p-2.5 rounded-xl bg-white border border-slate-200 hover:border-emerald-300 hover:shadow-md transition-all"
            >
              <div class="w-16 h-16 rounded-lg overflow-hidden bg-slate-100 shrink-0">
                <Image
                  src={rel.image}
                  alt={rel.title}
                  width={64}
                  height={64}
                  class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300"
                  loading="lazy"
                  format="webp"
                  quality={70}
                />
              </div>
              <div class="min-w-0">
                <p class="text-[10px] font-extrabold text-emerald-700 uppercase tracking-wider">{rel.category}</p>
                <p class="text-xs font-bold text-slate-900 line-clamp-2 group-hover:text-emerald-600 transition-colors leading-snug mt-0.5">
                  {rel.title}
                </p>
              </div>
            </a>
          ))}
        </div>

        <a
          href="/blog"
          class="mt-4 block text-center px-4 py-2.5 rounded-xl bg-emerald-50 text-emerald-700 font-extrabold text-xs hover:bg-emerald-600 hover:text-white transition-all"
        >
          Lihat Semua Artikel
        </a>
      </aside>
    </div>
  </article>
</Layout>

<style is:global>
  /* ====== BODY ARTIKEL: ANTI-LELAH BACA ====== */
  .article-body {
    max-width: 68ch;
    margin-inline: auto;
  }

  .article-paragraph {
    position: relative;
    padding: 1.1rem 1.25rem;
    border-radius: 0.9rem;
    background: transparent;
    transition: background-color 0.25s ease;
  }

  .article-paragraph.alt-paragraph {
    background: rgba(16, 185, 129, 0.045);
    border-left: 3px solid rgba(16, 185, 129, 0.35);
  }

  .article-paragraph.first-paragraph {
    padding-top: 0.25rem;
  }

  .article-paragraph.first-paragraph::first-letter {
    float: left;
    font-size: 3.6rem;
    line-height: 0.9;
    font-weight: 800;
    padding: 0.15rem 0.6rem 0 0;
    color: #047857;
    background: linear-gradient(135deg, #10b981, #047857);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .article-paragraph:hover {
    background: rgba(16, 185, 129, 0.08);
  }

  .kw-highlight {
    background: linear-gradient(180deg, transparent 60%, rgba(52, 211, 153, 0.35) 60%);
    color: inherit;
    padding: 0 0.1em;
    border-radius: 0.15em;
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .article-paragraph {
      padding: 0.9rem 0.9rem;
    }
    .article-paragraph.first-paragraph::first-letter {
      font-size: 2.8rem;
      padding-right: 0.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .article-paragraph {
      transition: none;
    }
  }
</style>