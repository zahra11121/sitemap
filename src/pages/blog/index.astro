// ====================== SEO CONFIG ======================
const siteUrl = 'https://greenfresh.co.id';
const pageUrl = `${siteUrl}/blog`;
const formattedPhone = '+6287780937884';
const pageTitle = 'Blog & Artikel Pertanian — CV Green Fresh Cipanas';
const pageDescription =
  'Kumpulan artikel edukasi seputar sayuran segar, panduan kualitas Grade A, manajemen dapur, nutrisi, dan tips pasokan B2B dari CV Green Fresh Cipanas.';

const jsonLdSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'CV Green Fresh Cipanas',
      url: siteUrl,
      telephone: formattedPhone,
      email: 'cs@greenfresh.co.id',
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: 'CV Green Fresh Cipanas',
      inLanguage: 'id-ID',
      publisher: { '@id': `${siteUrl}/#organization` },
    },
    {
      '@type': 'Blog',
      '@id': `${pageUrl}/#blog`,
      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      inLanguage: 'id-ID',
      publisher: { '@id': `${siteUrl}/#organization` },
      blogPost: articles.map((a) => ({
        '@type': 'BlogPosting',
        '@id': `${pageUrl}/${a.slug}/#article`,
        headline: a.title,
        description: a.excerpt,
        datePublished: a.date,
        dateModified: a.date,
        author: { '@type': 'Organization', name: a.author },
        publisher: { '@id': `${siteUrl}/#organization` },
        mainEntityOfPage: { '@type': 'WebPage', '@id': `${pageUrl}/${a.slug}` },
        image: `${siteUrl}/og-image.jpg`,
        articleSection: a.category,
        inLanguage: 'id-ID',
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}/#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Beranda', item: siteUrl },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: pageUrl },
      ],
    },
    {
      '@type': 'CollectionPage',
      '@id': `${pageUrl}/#collection`,
      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      inLanguage: 'id-ID',
      isPartOf: { '@id': `${siteUrl}/#website` },
      about: { '@id': `${pageUrl}/#blog` },
    },
  ],
};

const categories = ['Semua', ...new Set(articles.map((a) => a.category))];
---

<Layout title={pageTitle} description={pageDescription} canonical={pageUrl}>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content="CV Green Fresh Cipanas" />
    <meta name="theme-color" content="#064e3b" />
    <meta name="keywords" content="artikel sayuran segar, blog pertanian, tips sayur Grade A, supplier sayur B2B, manajemen dapur, nutrisi sayuran, CV Green Fresh Cipanas" />

    <meta name="geo.region" content="ID-JB" />
    <meta name="geo.placename" content="Pacet, Cianjur, Jawa Barat" />
    <meta name="geo.position" content="-6.7444817;107.0236364" />
    <meta name="ICBM" content="-6.7444817, 107.0236364" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CV Green Fresh Cipanas" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:image" content={`${siteUrl}/og-image.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={`${siteUrl}/og-image.jpg`} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLdSchema)} />
  </Fragment>

  <!-- HERO -->
  <section class="relative pt-12 pb-16 md:pt-24 md:pb-24 overflow-hidden bg-gradient-to-br from-emerald-950 via-emerald-900 to-slate-950 text-white">
    <div class="absolute -top-40 -left-40 w-96 h-96 bg-emerald-500/20 rounded-full blur-3xl animate-pulse"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/20 border border-emerald-400/30 text-emerald-300 text-[11px] md:text-sm font-semibold mb-4 backdrop-blur-md">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span> Edukasi Sayur & Pertanian
      </span>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-tight max-w-4xl mx-auto text-transparent bg-clip-text bg-gradient-to-r from-white via-emerald-100 to-teal-200">
        Blog Green Fresh Cipanas
      </h1>
      <p class="mt-3 text-xs sm:text-lg text-emerald-100/80 max-w-2xl mx-auto font-light leading-relaxed">
        Panduan kualitas, manajemen dapur, nutrisi, dan tips pasokan sayur segar untuk hotel, restoran, katering, dan supermarket.
      </p>
      <div class="mt-6 flex flex-row gap-3 justify-center items-center max-w-md mx-auto">
        <a href="#artikel" class="flex-1 px-5 py-3 rounded-xl bg-emerald-400 text-slate-950 font-extrabold text-xs md:text-base shadow-xl hover:bg-emerald-300 active:scale-95 transition-all text-center">
          Lihat Artikel
        </a>
        <a href="/" class="flex-1 px-5 py-3 rounded-xl bg-white/10 border border-white/20 text-white font-bold text-xs md:text-base backdrop-blur-md hover:bg-white/20 active:scale-95 transition-all text-center">
          Kembali ke Beranda
        </a>
      </div>
    </div>
  </section>

  <!-- FILTER KATEGORI + GRID ARTIKEL -->
  <section id="artikel" class="py-12 md:py-20 bg-gradient-to-b from-white via-emerald-50/30 to-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <span class="inline-block px-3.5 py-1 rounded-full bg-emerald-100 text-emerald-800 font-extrabold text-xs tracking-wider uppercase mb-2">Artikel Terbaru</span>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">20 Artikel Pilihan</h2>
      </div>

      <!-- FILTER -->
      <div class="sticky top-16 md:top-24 z-30 mb-8 bg-white/95 backdrop-blur-md p-3 rounded-2xl shadow-md border border-slate-200">
        <div class="flex gap-2 overflow-x-auto no-scrollbar pb-1">
          {categories.map((cat, index) => (
            <button
              class={`blog-filter-btn px-4 py-2 rounded-xl text-xs font-bold whitespace-nowrap transition-all duration-300 ${
                index === 0
                  ? 'bg-emerald-600 text-white shadow-lg shadow-emerald-600/30 active-category scale-105'
                  : 'bg-white text-slate-600 border border-slate-200 hover:bg-emerald-50 hover:text-emerald-700'
              }`}
              data-category={cat}
            >
              {cat}
            </button>
          ))}
        </div>
      </div>

      <!-- GRID -->
      <div id="blog-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5 md:gap-7">
        {articles.map((item) => (
          <a
            href={`/blog/${item.slug}`}
            class="blog-card group bg-white rounded-3xl overflow-hidden border border-slate-200/80 shadow-sm hover:shadow-2xl hover:border-emerald-300 transition-all duration-300 flex flex-col"
            data-category={item.category}
          >
            <div class="relative aspect-[4/3] bg-slate-100 overflow-hidden">
              <Image
                src={item.image}
                alt={`${item.title} — CV Green Fresh Cipanas`}
                width={480}
                height={360}
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 ease-out"
                loading="lazy"
                decoding="async"
                format="webp"
                quality={80}
              />
              <span class="absolute top-3 left-3 bg-white/95 backdrop-blur-md text-emerald-800 text-[9px] md:text-[10px] font-extrabold px-2.5 py-1 rounded-full border border-emerald-100 shadow-sm">
                {item.category}
              </span>
            </div>
            <div class="p-4 md:p-5 flex flex-col flex-grow">
              <div class="flex items-center gap-2 text-[10px] md:text-xs text-slate-400 font-semibold mb-2">
                <time datetime={item.date}>{new Date(item.date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' })}</time>
                <span>•</span>
                <span>{item.readTime} menit baca</span>
              </div>
              <h3 class="font-extrabold text-slate-900 text-sm md:text-base leading-snug line-clamp-2 group-hover:text-emerald-600 transition-colors">
                {item.title}
              </h3>
              <p class="mt-2 text-xs md:text-sm text-slate-500 leading-relaxed line-clamp-3 flex-grow">
                {item.excerpt}
              </p>
              <span class="mt-4 inline-flex items-center gap-1.5 text-emerald-700 font-extrabold text-[11px] md:text-xs">
                Baca Selengkapnya
                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-12 md:py-20 bg-gradient-to-br from-emerald-900 via-teal-900 to-slate-900 text-white">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="text-2xl md:text-4xl font-extrabold">Butuh Pasokan Sayur Segar?</h2>
      <p class="mt-3 text-emerald-100/80 text-xs md:text-base">
        CV Green Fresh Cipanas siap memasok hotel, restoran, katering, dan supermarket dengan sayur Grade A, termin 7 hari, minimal order Rp 1.500.000.
      </p>
      <div class="mt-6 flex flex-row gap-3 justify-center max-w-md mx-auto">
        <a
          href="https://wa.me/6287780937884?text=Halo%20Green%20Fresh%2C%20saya%20ingin%20konsultasi%20pasokan%20sayur."
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 px-5 py-3.5 rounded-xl bg-emerald-400 text-slate-950 font-extrabold text-xs md:text-base shadow-xl hover:bg-emerald-300 active:scale-95 transition-all"
        >
          Chat WhatsApp
        </a>
        <a
          href="/#order-form"
          class="flex-1 px-5 py-3.5 rounded-xl bg-white/10 border border-white/20 text-white font-bold text-xs md:text-base backdrop-blur-md hover:bg-white/20 active:scale-95 transition-all"
        >
          Form Order
        </a>
      </div>
    </div>
  </section>

  <style>
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>

  <script>
    const filterBtns = document.querySelectorAll('.blog-filter-btn');
    const blogCards = document.querySelectorAll('.blog-card');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => {
          b.classList.remove('bg-emerald-600', 'text-white', 'shadow-lg', 'shadow-emerald-600/30', 'active-category', 'scale-105');
          b.classList.add('bg-white', 'text-slate-600', 'border', 'border-slate-200');
        });
        btn.classList.remove('bg-white', 'text-slate-600', 'border', 'border-slate-200');
        btn.classList.add('bg-emerald-600', 'text-white', 'shadow-lg', 'shadow-emerald-600/30', 'active-category', 'scale-105');

        const cat = (btn as HTMLElement).dataset.category || 'Semua';

        blogCards.forEach((card) => {
          const el = card as HTMLElement;
          if (cat === 'Semua' || el.dataset.category === cat) {
            el.classList.remove('hidden');
          } else {
            el.classList.add('hidden');
          }
        });
      });
    });
  </script>
</Layout>