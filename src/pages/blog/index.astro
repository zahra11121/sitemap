---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { articles } from '../../data/articles';

// ====================== SEO CONFIG ======================
const siteUrl = 'https://greenfresh.co.id';
const pageUrl = `${siteUrl}/blog`;
const formattedPhone = '+6287780937884';
const pageTitle = 'Blog & Artikel Pertanian — CV Green Fresh Cipanas';
const pageDescription =
  'Kumpulan artikel edukasi seputar sayuran segar, panduan kualitas Grade A, manajemen dapur, nutrisi, dan tips pasokan B2B dari CV Green Fresh Cipanas.';

const jsonLdSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'CV Green Fresh Cipanas',
      url: siteUrl,
      telephone: formattedPhone,
      email: 'cs@greenfresh.co.id',
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: 'CV Green Fresh Cipanas',
      inLanguage: 'id-ID',
      publisher: { '@id': `${siteUrl}/#organization` },
    },
    {
      '@type': 'Blog',
      '@id': `${pageUrl}/#blog`,
      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      inLanguage: 'id-ID',
      publisher: { '@id': `${siteUrl}/#organization` },
      blogPost: articles.map((a) => ({
        '@type': 'BlogPosting',
        '@id': `${pageUrl}/${a.slug}/#article`,
        headline: a.title,
        description: a.excerpt,
        datePublished: a.date,
        dateModified: a.date,
        author: { '@type': 'Organization', name: a.author },
        publisher: { '@id': `${siteUrl}/#organization` },
        mainEntityOfPage: { '@type': 'WebPage', '@id': `${pageUrl}/${a.slug}` },
        image: `${siteUrl}/og-image.jpg`,
        articleSection: a.category,
        inLanguage: 'id-ID',
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}/#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Beranda', item: siteUrl },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: pageUrl },
      ],
    },
    {
      '@type': 'CollectionPage',
      '@id': `${pageUrl}/#collection`,
      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      inLanguage: 'id-ID',
      isPartOf: { '@id': `${siteUrl}/#website` },
      about: { '@id': `${pageUrl}/#blog` },
    },
  ],
};

// sort by date desc
const sortedArticles = [...articles].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);
const featured = sortedArticles[0];
const rest = sortedArticles.slice(1);

const categories = ['Semua', ...new Set(articles.map((a) => a.category))];

// hitung artikel per kategori
const categoryCounts: Record<string, number> = {
  Semua: articles.length,
};
for (const a of articles) {
  categoryCounts[a.category] = (categoryCounts[a.category] || 0) + 1;
}

// emoji per kategori (fallback 📄)
const categoryEmoji: Record<string, string> = {
  'Panduan Kualitas': '🏅',
  'Nutrisi & Kesehatan': '🥗',
  'Edukasi Pertanian': '🌱',
  'Manajemen Dapur': '📋',
  'Resep & Olahan': '🍳',
};

const totalReadMinutes = articles.reduce((sum, a) => sum + a.readTime, 0);

const formatDate = (d: string) =>
  new Date(d).toLocaleDateString('id-ID', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });
---

<Layout title={pageTitle} description={pageDescription} canonical={pageUrl}>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content="CV Green Fresh Cipanas" />
    <meta name="theme-color" content="#064e3b" />
    <meta name="keywords" content="artikel sayuran segar, blog pertanian, tips sayur Grade A, supplier sayur B2B, manajemen dapur, nutrisi sayuran, CV Green Fresh Cipanas" />

    <meta name="geo.region" content="ID-JB" />
    <meta name="geo.placename" content="Pacet, Cianjur, Jawa Barat" />
    <meta name="geo.position" content="-6.7444817;107.0236364" />
    <meta name="ICBM" content="-6.7444817, 107.0236364" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CV Green Fresh Cipanas" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:image" content={`${siteUrl}/og-image.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={`${siteUrl}/og-image.jpg`} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLdSchema)} />
  </Fragment>

  <!-- ===================== HERO ===================== -->
  <section class="relative pt-14 pb-20 md:pt-24 md:pb-28 overflow-hidden bg-slate-950 text-white">
    <!-- background grid -->
    <div class="absolute inset-0 opacity-[0.07]" style="background-image: radial-gradient(circle, #fff 1px, transparent 1px); background-size: 28px 28px;"></div>
    <!-- gradient glow -->
    <div class="absolute -top-40 -left-32 w-[28rem] h-[28rem] bg-emerald-500/25 rounded-full blur-3xl animate-pulse"></div>
    <div class="absolute -bottom-40 -right-32 w-[28rem] h-[28rem] bg-teal-500/20 rounded-full blur-3xl"></div>
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-72 h-72 bg-lime-400/10 rounded-full blur-3xl"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-3xl mx-auto">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/15 border border-emerald-400/30 text-emerald-300 text-[11px] md:text-sm font-semibold mb-5 backdrop-blur-md">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          Edukasi Sayur & Pertanian
        </span>

        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight leading-[1.05]">
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-emerald-100 to-teal-200">
            Blog Green Fresh
          </span>
          <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-300 via-teal-300 to-emerald-400">
            Cipanas
          </span>
        </h1>

        <p class="mt-5 text-sm sm:text-lg text-emerald-100/70 max-w-2xl mx-auto font-light leading-relaxed">
          Wawasan seputar sayur segar, standar kualitas Grade A, manajemen dapur, dan tips pasokan B2B untuk hotel, restoran, katering, dan supermarket.
        </p>

        <!-- Stats -->
        <div class="mt-8 grid grid-cols-3 gap-2 sm:gap-4 max-w-lg mx-auto">
          <div class="rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md p-3 sm:p-4">
            <div class="text-2xl sm:text-3xl font-black text-emerald-300">{articles.length}</div>
            <div class="text-[10px] sm:text-xs text-emerald-100/60 font-semibold uppercase tracking-wider mt-0.5">Artikel</div>
          </div>
          <div class="rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md p-3 sm:p-4">
            <div class="text-2xl sm:text-3xl font-black text-teal-300">{categories.length - 1}</div>
            <div class="text-[10px] sm:text-xs text-emerald-100/60 font-semibold uppercase tracking-wider mt-0.5">Kategori</div>
          </div>
          <div class="rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md p-3 sm:p-4">
            <div class="text-2xl sm:text-3xl font-black text-lime-300">{totalReadMinutes}</div>
            <div class="text-[10px] sm:text-xs text-emerald-100/60 font-semibold uppercase tracking-wider mt-0.5">Menit Baca</div>
          </div>
        </div>

        <div class="mt-7 flex flex-row gap-3 justify-center items-center max-w-md mx-auto">
          <a href="#artikel" class="flex-1 px-5 py-3 rounded-xl bg-emerald-400 text-slate-950 font-extrabold text-xs md:text-base shadow-xl shadow-emerald-400/20 hover:bg-emerald-300 active:scale-95 transition-all text-center">
            Mulai Baca
          </a>
          <a href="/" class="flex-1 px-5 py-3 rounded-xl bg-white/10 border border-white/20 text-white font-bold text-xs md:text-base backdrop-blur-md hover:bg-white/20 active:scale-95 transition-all text-center">
            Beranda
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== FEATURED ARTICLE ===================== -->
  <section class="relative -mt-10 md:-mt-16 z-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <a
        href={`/blog/${featured.slug}`}
        class="featured-card group block bg-white rounded-3xl shadow-2xl shadow-emerald-900/10 border border-slate-200/80 overflow-hidden hover:shadow-emerald-900/20 hover:border-emerald-300 transition-all duration-500"
      >
        <div class="grid md:grid-cols-2">
          <div class="relative aspect-[16/10] md:aspect-auto md:min-h-[380px] overflow-hidden bg-slate-100">
            <Image
              src={featured.image}
              alt={`${featured.title} — CV Green Fresh Cipanas`}
              width={900}
              height={600}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
              loading="eager"
              decoding="async"
              format="webp"
              quality={85}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent md:bg-gradient-to-r"></div>
            <div class="absolute top-4 left-4 flex flex-wrap gap-2">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-gradient-to-r from-emerald-500 to-teal-500 text-white text-[10px] md:text-xs font-extrabold uppercase tracking-wider shadow-lg shadow-emerald-500/30">
                ⭐ Artikel Pilihan
              </span>
            </div>
          </div>

          <div class="p-6 sm:p-8 md:p-10 flex flex-col justify-center">
            <div class="flex flex-wrap items-center gap-2 text-[10px] md:text-xs font-semibold mb-3">
              <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-100">
                <span>{categoryEmoji[featured.category] ?? '📄'}</span>
                {featured.category}
              </span>
              <span class="text-slate-400">•</span>
              <time datetime={featured.date} class="text-slate-500">{formatDate(featured.date)}</time>
              <span class="text-slate-400">•</span>
              <span class="text-slate-500">{featured.readTime} menit baca</span>
            </div>

            <h2 class="text-xl sm:text-3xl lg:text-4xl font-black text-slate-900 leading-tight tracking-tight group-hover:text-emerald-700 transition-colors">
              {featured.title}
            </h2>

            <p class="mt-3 text-sm md:text-base text-slate-600 leading-relaxed line-clamp-3">
              {featured.excerpt}
            </p>

            <div class="mt-6 flex items-center justify-between gap-3">
              <div class="flex items-center gap-2">
                <div class="w-9 h-9 rounded-full bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center text-white font-extrabold text-xs">
                  GF
                </div>
                <div class="text-xs">
                  <div class="font-extrabold text-slate-900">{featured.author}</div>
                  <div class="text-slate-400 font-semibold">Penulis</div>
                </div>
              </div>

              <span class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-600 text-white font-extrabold text-xs md:text-sm group-hover:bg-emerald-500 transition-colors shadow-lg shadow-emerald-600/20">
                Baca Artikel
                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </span>
            </div>
          </div>
        </div>
      </a>
    </div>
  </section>

  <!-- ===================== FILTER + SEARCH + GRID ===================== -->
  <section id="artikel" class="py-12 md:py-20 bg-gradient-to-b from-white via-emerald-50/30 to-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-10">
        <span class="inline-block px-3.5 py-1 rounded-full bg-emerald-100 text-emerald-800 font-extrabold text-[10px] md:text-xs tracking-wider uppercase mb-2">
          Semua Artikel
        </span>
        <h2 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight">
          Jelajahi <span class="text-emerald-600">{articles.length}</span> Artikel
        </h2>
        <p class="mt-2 text-xs md:text-sm text-slate-500 max-w-xl mx-auto">
          Gunakan pencarian atau filter kategori untuk menemukan artikel yang Anda butuhkan.
        </p>
      </div>

      <!-- Sticky toolbar: search + filter -->
      <div class="sticky top-16 md:top-20 z-30 mb-8">
        <div class="bg-white/95 backdrop-blur-md p-3 md:p-4 rounded-2xl shadow-lg shadow-slate-900/5 border border-slate-200 space-y-3">
          <!-- Search -->
          <div class="relative">
            <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z" />
            </svg>
            <input
              id="blog-search"
              type="search"
              placeholder="Cari artikel… (mis. wortel, chiller, cabai)"
              class="w-full pl-10 pr-10 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-sm text-slate-800 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-400 transition-all"
            />
            <button
              id="blog-search-clear"
              type="button"
              class="hidden absolute right-2 top-1/2 -translate-y-1/2 w-7 h-7 rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-600 flex items-center justify-center transition-colors"
              aria-label="Hapus pencarian"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>

          <!-- Filter -->
          <div class="flex gap-2 overflow-x-auto no-scrollbar pb-0.5">
            {categories.map((cat, index) => (
              <button
                class={`blog-filter-btn group inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold whitespace-nowrap transition-all duration-300 ${
                  index === 0
                    ? 'bg-emerald-600 text-white shadow-lg shadow-emerald-600/30 scale-105'
                    : 'bg-white text-slate-600 border border-slate-200 hover:bg-emerald-50 hover:text-emerald-700 hover:border-emerald-200'
                }`}
                data-category={cat}
              >
                <span class="text-sm">{categoryEmoji[cat] ?? (cat === 'Semua' ? '✨' : '📄')}</span>
                <span>{cat}</span>
                <span class={`text-[10px] px-1.5 py-0.5 rounded-md font-extrabold ${index === 0 ? 'bg-white/20' : 'bg-slate-100 group-hover:bg-emerald-100'}`}>
                  {categoryCounts[cat]}
                </span>
              </button>
            ))}
          </div>
        </div>
      </div>

      <!-- Result info -->
      <div class="mb-4 flex items-center justify-between text-xs md:text-sm">
        <p class="text-slate-500">
          Menampilkan <span id="result-count" class="font-extrabold text-emerald-700">{rest.length}</span> artikel
          <span id="filter-label" class="hidden"> • filter aktif: <span class="font-bold text-slate-700"></span></span>
        </p>
      </div>

      <!-- Grid -->
      <div id="blog-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5 md:gap-7">
        {rest.map((item, i) => (
          <a
            href={`/blog/${item.slug}`}
            class="blog-card reveal group bg-white rounded-3xl overflow-hidden border border-slate-200/80 shadow-sm hover:shadow-2xl hover:-translate-y-1.5 hover:border-emerald-300 transition-all duration-300 flex flex-col"
            data-category={item.category}
            data-search={`${item.title} ${item.excerpt} ${item.category}`.toLowerCase()}
            style={`transition-delay:${Math.min(i * 40, 400)}ms`}
          >
            <div class="relative aspect-[4/3] bg-slate-100 overflow-hidden">
              <Image
                src={item.image}
                alt={`${item.title} — CV Green Fresh Cipanas`}
                width={480}
                height={360}
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 ease-out"
                loading="lazy"
                decoding="async"
                format="webp"
                quality={80}
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>

              <span class="absolute top-3 left-3 inline-flex items-center gap-1 bg-white/95 backdrop-blur-md text-emerald-800 text-[9px] md:text-[10px] font-extrabold px-2.5 py-1 rounded-full border border-emerald-100 shadow-sm">
                <span>{categoryEmoji[item.category] ?? '📄'}</span>
                {item.category}
              </span>

              <span class="absolute top-3 right-3 inline-flex items-center gap-1 bg-slate-900/70 backdrop-blur-md text-white text-[9px] md:text-[10px] font-bold px-2 py-1 rounded-full">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                {item.readTime}m
              </span>
            </div>

            <div class="p-4 md:p-5 flex flex-col flex-grow">
              <div class="flex items-center gap-2 text-[10px] md:text-xs text-slate-400 font-semibold mb-2">
                <time datetime={item.date}>{formatDate(item.date)}</time>
              </div>
              <h3 class="font-extrabold text-slate-900 text-sm md:text-base leading-snug line-clamp-2 group-hover:text-emerald-600 transition-colors">
                {item.title}
              </h3>
              <p class="mt-2 text-xs md:text-sm text-slate-500 leading-relaxed line-clamp-3 flex-grow">
                {item.excerpt}
              </p>
              <span class="mt-4 inline-flex items-center gap-1.5 text-emerald-700 font-extrabold text-[11px] md:text-xs">
                Baca Selengkapnya
                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>

      <!-- Empty state -->
      <div id="empty-state" class="hidden text-center py-20">
        <div class="w-20 h-20 mx-auto rounded-full bg-slate-100 flex items-center justify-center mb-4">
          <svg class="w-10 h-10 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z" />
          </svg>
        </div>
        <h3 class="text-lg md:text-xl font-extrabold text-slate-800">Artikel tidak ditemukan</h3>
        <p class="mt-1.5 text-sm text-slate-500">Coba kata kunci lain atau pilih kategori "Semua".</p>
        <button
          id="reset-filter"
          class="mt-5 inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-emerald-600 text-white font-extrabold text-sm hover:bg-emerald-500 active:scale-95 transition-all"
        >
          Reset Filter
        </button>
      </div>
    </div>
  </section>

  <!-- ===================== CTA ===================== -->
  <section class="relative py-16 md:py-24 bg-slate-950 text-white overflow-hidden">
    <div class="absolute inset-0 opacity-[0.08]" style="background-image: radial-gradient(circle, #fff 1px, transparent 1px); background-size: 24px 24px;"></div>
    <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[36rem] h-[36rem] bg-emerald-500/20 rounded-full blur-3xl"></div>

    <div class="max-w-3xl mx-auto px-4 text-center relative z-10">
      <span class="inline-block px-3.5 py-1 rounded-full bg-emerald-500/15 border border-emerald-400/30 text-emerald-300 text-[10px] md:text-xs font-extrabold uppercase tracking-wider mb-4">
        Siap Pasokan?
      </span>
      <h2 class="text-3xl md:text-5xl font-black tracking-tight leading-tight">
        Butuh Pasokan <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-300 to-teal-300">Sayur Segar</span>?
      </h2>
      <p class="mt-4 text-emerald-100/70 text-sm md:text-base max-w-xl mx-auto leading-relaxed">
        CV Green Fresh Cipanas memasok hotel, restoran, katering, dan supermarket dengan sayur Grade A.
      </p>

      <div class="mt-6 flex flex-wrap justify-center gap-2 text-[10px] md:text-xs font-bold">
        <span class="px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-emerald-100">✓ Termin 7 Hari</span>
        <span class="px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-emerald-100">✓ Minimal Order Rp 1.500.000</span>
        <span class="px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-emerald-100">✓ Garansi Retur</span>
      </div>

      <div class="mt-7 flex flex-row gap-3 justify-center max-w-md mx-auto">
        <a
          href="https://wa.me/6287780937884?text=Halo%20Green%20Fresh%2C%20saya%20ingin%20konsultasi%20pasokan%20sayur."
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 px-5 py-3.5 rounded-xl bg-emerald-400 text-slate-950 font-extrabold text-xs md:text-base shadow-xl shadow-emerald-400/30 hover:bg-emerald-300 active:scale-95 transition-all"
        >
          Chat WhatsApp
        </a>
        <a
          href="/#order-form"
          class="flex-1 px-5 py-3.5 rounded-xl bg-white/10 border border-white/20 text-white font-bold text-xs md:text-base backdrop-blur-md hover:bg-white/20 active:scale-95 transition-all"
        >
          Form Order
        </a>
      </div>
    </div>
  </section>

  <style>
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

    /* Scroll reveal */
    .reveal { opacity: 0; transform: translateY(12px); transition: opacity .5s ease, transform .5s ease; }
    .reveal.is-visible { opacity: 1; transform: translateY(0); }

    /* Hide card when filtered */
    .blog-card.is-hidden { display: none; }
  </style>

  <script>
    // ============ Refs ============
    const filterBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.blog-filter-btn'));
    const blogCards = Array.from(document.querySelectorAll<HTMLElement>('.blog-card'));
    const searchInput = document.getElementById('blog-search') as HTMLInputElement | null;
    const searchClear = document.getElementById('blog-search-clear');
    const resultCount = document.getElementById('result-count');
    const filterLabel = document.getElementById('filter-label');
    const filterLabelValue = filterLabel?.querySelector('span');
    const emptyState = document.getElementById('empty-state');
    const resetBtn = document.getElementById('reset-filter');

    let activeCategory = 'Semua';
    let searchQuery = '';

    // ============ Filter logic ============
    function applyFilters() {
      let visible = 0;

      blogCards.forEach((card) => {
        const cat = card.dataset.category || '';
        const hay = (card.dataset.search || '').toLowerCase();

        const matchCat = activeCategory === 'Semua' || cat === activeCategory;
        const matchSearch = searchQuery === '' || hay.includes(searchQuery);

        if (matchCat && matchSearch) {
          card.classList.remove('is-hidden');
          visible++;
        } else {
          card.classList.add('is-hidden');
        }
      });

      if (resultCount) resultCount.textContent = String(visible);

      // label filter
      if (filterLabel && filterLabelValue) {
        if (activeCategory !== 'Semua' && visible !== blogCards.length) {
          filterLabel.classList.remove('hidden');
          filterLabelValue.textContent = activeCategory;
        } else {
          filterLabel.classList.add('hidden');
        }
      }

      // empty state
      if (emptyState) {
        if (visible === 0) emptyState.classList.remove('hidden');
        else emptyState.classList.add('hidden');
      }
    }

    // ============ Kategori buttons ============
    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        // reset semua
        filterBtns.forEach((b) => {
          b.classList.remove(
            'bg-emerald-600', 'text-white', 'shadow-lg', 'shadow-emerald-600/30',
            'scale-105', 'border-emerald-200'
          );
          b.classList.add('bg-white', 'text-slate-600', 'border', 'border-slate-200');
        });

        // aktifkan
        btn.classList.remove('bg-white', 'text-slate-600', 'border', 'border-slate-200');
        btn.classList.add('bg-emerald-600', 'text-white', 'shadow-lg', 'shadow-emerald-600/30', 'scale-105');

        activeCategory = btn.dataset.category || 'Semua';
        applyFilters();
      });
    });

    // ============ Search ============
    searchInput?.addEventListener('input', () => {
      searchQuery = searchInput.value.trim().toLowerCase();
      if (searchClear) {
        if (searchQuery) searchClear.classList.remove('hidden');
        else searchClear.classList.add('hidden');
      }
      applyFilters();
    });

    searchClear?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        searchInput.focus();
      }
      searchQuery = '';
      searchClear.classList.add('hidden');
      applyFilters();
    });

    // ============ Reset ============
    resetBtn?.addEventListener('click', () => {
      activeCategory = 'Semua';
      searchQuery = '';
      if (searchInput) searchInput.value = '';
      if (searchClear) searchClear.classList.add('hidden');

      filterBtns.forEach((b, i) => {
        if (i === 0) {
          b.classList.add('bg-emerald-600', 'text-white', 'shadow-lg', 'shadow-emerald-600/30', 'scale-105');
          b.classList.remove('bg-white', 'text-slate-600', 'border', 'border-slate-200');
        } else {
          b.classList.remove('bg-emerald-600', 'text-white', 'shadow-lg', 'shadow-emerald-600/30', 'scale-105');
          b.classList.add('bg-white', 'text-slate-600', 'border', 'border-slate-200');
        }
      });
      applyFilters();
    });

    // ============ Scroll reveal ============
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            (entry.target as HTMLElement).classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
    );
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

    // init count
    applyFilters();
  </script>
</Layout>